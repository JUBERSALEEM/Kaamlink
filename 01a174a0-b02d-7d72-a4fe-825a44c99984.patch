+    }
+
+    /// <summary>
+    /// Companion to <see cref="VerificationStateColorConverter"/>: company
+    /// verification tone → soft pill background.
+    /// </summary>
+    public sealed class VerificationStateSoftColorConverter : IValueConverter
+    {
+        public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture)
+        {
+            var tokenKey = value as string switch
+            {
+                "Pending" => "WarningSoft",
+                "Verified" => "SuccessSoft",
+                "Rejected" => "ErrorSoft",
+                _ => "CardSurfaceAlt"
+            };
+
+            return Application.Current?.Resources.TryGetValue(tokenKey, out var color) == true
+                ? color
+                : Colors.Transparent;
+        }
+
+        public object ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            throw new NotSupportedException();
+    }
+
+    /// <summary>
+    /// True when the bound string has content. Used to show/hide optional blocks
+    /// (about text, cover notes) without adding extra boolean view-model members.
+    /// </summary>
+    public sealed class StringHasContentConverter : IValueConverter
+    {
+        public object Convert(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            value is string text && !string.IsNullOrWhiteSpace(text);
+
+        public object ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            throw new NotSupportedException();
+    }
+
+    /// <summary>Count → "N items" style boolean used by small count badges.</summary>
+    public sealed class CountPositiveConverter : IValueConverter
+    {
+        public object Convert(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            value is int count && count > 0;
+
+        public object ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            throw new NotSupportedException();
+    }
+    /// <summary>
+    /// Step-rail colouring for the onboarding stepper. The view model already
+    /// exposes which step is active (IsStep1/IsStep2/IsStep3); this maps that to
+    /// Primary (reached) or Divider (not reached) so the rail needs no extra state.
+    /// ConverterParameter: "reached" = true means Primary, "ahead" = true means Divider.
+    /// </summary>
+    public sealed class StageColorConverter : IValueConverter
+    {
+        public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture)
+        {
+            var flag = value is true;
+            var wantPrimary = parameter as string == "reached" ? flag : !flag;
+            var tokenKey = wantPrimary ? "Primary" : "Divider";
+
+            return Application.Current?.Resources.TryGetValue(tokenKey, out var color) == true
+                ? color
+                : Colors.Gray;
+        }
+
+        public object ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            throw new NotSupportedException();
+    }
+    /// <summary>True when the bound count is zero (used for "nothing yet" hints).</summary>
+    public sealed class CountEmptyConverter : IValueConverter
+    {
+        public object Convert(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            value is int count && count == 0;
+
+        public object ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            throw new NotSupportedException();
+    }
+    /// <summary>
+    /// True when the bound string equals the ConverterParameter (ordinal).
+    /// Lets a page branch on a single API enum value without adding booleans to
+    /// the view model (e.g. verification state == "Verified").
+    /// </summary>
+    public sealed class StringEqualsConverter : IValueConverter
+    {
+        public object Convert(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            value is string text
+            && parameter is string expected
+            && string.Equals(text, expected, StringComparison.Ordinal);
+
+        public object ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture) =>
+            throw new NotSupportedException();
+    }
 }
diff --git a/Core/Presentation/Theming/ThemeCatalog.cs b/Core/Presentation/Theming/ThemeCatalog.cs
new file mode 100644
index 0000000..12dcbd1
--- /dev/null
+++ b/Core/Presentation/Theming/ThemeCatalog.cs
@@ -0,0 +1,52 @@
+namespace KaamLink.Core.Presentation.Theming
+{
+    /// <summary>
+    /// One selectable theme: an id (stable, persisted) and the palette dictionary
+    /// that supplies every colour token for it.
+    ///
+    /// A theme is a PALETTE SWAP. Layout, typography, spacing and control recipes
+    /// all live in Styles.xaml and are shared by every theme, which is what keeps
+    /// a new theme from becoming a second design.
+    /// </summary>
+    public sealed record ThemeDefinition(string Id, string PaletteSource);
+
+    /// <summary>The themes the app ships with, in the order the toggle cycles them.</summary>
+    public static class ThemeCatalog
+    {
+        public const string Clay = "clay";
+        public const string ClayDusk = "clay-dusk";
+
+        public static readonly IReadOnlyList<ThemeDefinition> All =
+        [
+            new(Clay, "Resources/Styles/Colors.xaml"),
+            new(ClayDusk, "Resources/Themes/ClayDusk.xaml")
+        ];
+
+        public static ThemeDefinition Resolve(string? id) =>
+            All.FirstOrDefault(theme => theme.Id == id) ?? All[0];
+
+        public static ThemeDefinition Next(string? id)
+        {
+            var index = All.ToList().FindIndex(theme => theme.Id == Resolve(id).Id);
+            return All[(index + 1) % All.Count];
+        }
+
+        public static bool IsKnown(string? id) => All.Any(theme => theme.Id == id);
+    }
+
+    /// <summary>Applies and reports the app-wide theme.</summary>
+    public interface IThemeService
+    {
+        /// <summary>Id of the active theme; survives restarts.</summary>
+        string CurrentThemeId { get; }
+
+        /// <summary>Raised after a switch, with the new theme id.</summary>
+        event EventHandler<string>? ThemeChanged;
+
+        /// <summary>Activates a theme. Unknown ids fall back to the default.</summary>
+        void Apply(string themeId);
+
+        /// <summary>Activates the next theme in the catalogue.</summary>
+        string Toggle();
+    }
+}
diff --git a/Core/Presentation/Theming/ThemeService.cs b/Core/Presentation/Theming/ThemeService.cs
new file mode 100644
index 0000000..e4db37c
--- /dev/null
+++ b/Core/Presentation/Theming/ThemeService.cs
@@ -0,0 +1,169 @@
+using KaamLink.Core.Presentation.Clay;
+using Microsoft.Maui.ApplicationModel;
+using Microsoft.Maui.Storage;
+
+namespace KaamLink.Core.Presentation.Theming
+{
+    /// <summary>
+    /// Swaps the palette <see cref="ResourceDictionary"/> merged into
+    /// <see cref="Application.Resources"/> and re-applies clay shadows.
+    ///
+    /// Everything else follows automatically because pages and styles reference
+    /// colour tokens with <c>{DynamicResource}</c>: replacing the palette
+    /// dictionary raises a resource change, and every element repaints.
+    /// </summary>
+    public sealed class ThemeService : IThemeService
+    {
+        private const string PreferenceKey = "kaamlink.theme";
+
+        // The palette dictionary this service merged, so a source path that stops
+        // matching cannot hide it from the removal sweep.
+        private ResourceDictionary? _palette;
+
+        public ThemeService() => CurrentThemeId = ReadStoredThemeId();
+
+        public string CurrentThemeId { get; private set; }
+
+        public event EventHandler<string>? ThemeChanged;
+
+        public void Apply(string themeId)
+        {
+            var theme = ThemeCatalog.Resolve(themeId);
+
+            void Swap()
+            {
+                try
+                {
+                    SwapCore();
+                }
+                catch (Exception exception)
+                {
+                    // Both callers are startup paths (CreateWindow) and the UI thread.
+                    // A failed palette load must degrade to the currently merged
+                    // palette, never take the process down.
+                    Console.WriteLine($"[KaamLink] theme '{theme.Id}' could not be applied: {exception}");
+                }
+            }
+
+            void SwapCore()
+            {
+                // MergedDictionaries is ICollection<ResourceDictionary> in .NET MAUI -
+                // no indexer, no Insert, no RemoveAt. So the replacement is appended
+                // rather than placed back in the palette's slot. That is safe only
+                // because no key is defined by more than one merged dictionary
+                // (asserted by tools/verify-ui-redesign.py section K), so merge ORDER
+                // cannot change which value a key resolves to.
+                var merged = Application.Current?.Resources.MergedDictionaries;
+                if (merged is null)
+                    return;
+
+                var replacement = new ResourceDictionary
+                {
+                    Source = new Uri(theme.PaletteSource, UriKind.Relative)
+                };
+
+                // Remove then Add (rather than mutating in place) is what makes MAUI
+                // raise the change that repaints DynamicResource consumers. Every
+                // catalogue palette is removed, not just the tracked one: if a source
+                // path ever stops matching, a single lookup would leave the old palette
+                // merged and the collection would grow on every toggle.
+                foreach (var dictionary in merged.ToList())
+                {
+                    if (IsPalette(dictionary) || ReferenceEquals(dictionary, _palette))
+                        merged.Remove(dictionary);
+                }
+
+                merged.Add(replacement);
+                _palette = replacement;
+
+                CurrentThemeId = theme.Id;
+                WriteStoredThemeId(theme.Id);
+                ThemeChanged?.Invoke(this, theme.Id);
+
+                // Deferred by one dispatcher turn so the replacement dictionary is
+                // loaded before shadows read ClayShadowBrush from it; resolving too
+                // early would give every shadow the fallback colour.
+                var dispatcher = Application.Current?.Dispatcher;
+                if (dispatcher is not null && !dispatcher.IsDispatchRequired)
+                    dispatcher.Dispatch(RefreshClayShadows);
+                else
+                    RefreshClayShadows();
+            }
+
+            if (MainThread.IsMainThread)
+                Swap();
+            else
+                MainThread.BeginInvokeOnMainThread(Swap);
+        }
+
+        public string Toggle()
+        {
+            var next = ThemeCatalog.Next(CurrentThemeId);
+            Apply(next.Id);
+            return next.Id;
+        }
+
+        private static bool IsPalette(ResourceDictionary dictionary)
+        {
+            var source = Normalize(dictionary.Source);
+            return source is not null
+                && ThemeCatalog.All.Any(theme =>
+                    string.Equals(Normalize(theme.PaletteSource), source, StringComparison.OrdinalIgnoreCase));
+        }
+
+        private static string? Normalize(Uri? uri) => Normalize(uri?.OriginalString);
+
+        private static string? Normalize(string? source) =>
+            source?.TrimStart('/').Replace('\\', '/');
+
+        private static void RefreshClayShadows()
+        {
+            try
+            {
+                var application = Application.Current;
+                if (application is null)
+                    return;
+
+                foreach (var window in application.Windows)
+                {
+                    if (window.Page is { } page)
+                        ClayMaterial.Refresh(page);
+                }
+            }
+            catch (Exception exception)
+            {
+                // Runs on the dispatcher after a switch, so an escaping exception
+                // would be an unhandled UI-thread crash. A missed shadow refresh is
+                // cosmetic and must stay cosmetic.
+                Console.WriteLine($"[KaamLink] clay shadow refresh failed: {exception}");
+            }
+        }
+
+        // Preferences touches platform storage; a failure there must not stop the
+        // app from starting with the default theme.
+        private static string ReadStoredThemeId()
+        {
+            try
+            {
+                var stored = Preferences.Default.Get(PreferenceKey, ThemeCatalog.Clay);
+                return ThemeCatalog.IsKnown(stored) ? stored : ThemeCatalog.Clay;
+            }
+            catch
+            {
+                return ThemeCatalog.Clay;
+            }
+        }
+
+        private static void WriteStoredThemeId(string themeId)
+        {
+            try
+            {
+                Preferences.Default.Set(PreferenceKey, themeId);
+            }
+            catch
+            {
+                // Not fatal: the theme still applies for this session.
+            }
+        }
+    }
+}
diff --git a/Core/Text/CountryPhoneDirectory.cs b/Core/Text/CountryPhoneDirectory.cs
new file mode 100644
index 0000000..71b0152
--- /dev/null
+++ b/Core/Text/CountryPhoneDirectory.cs
@@ -0,0 +1,75 @@
+using System.Globalization;
+using System.Text.Json;
+using Microsoft.Maui.Storage;
+
+namespace KaamLink.Core.Text;
+
+/// <summary>
+/// Offline country/region and calling-code directory. The small metadata file is
+/// shipped with the app so the picker works before sign-in and without a network.
+/// Display names are resolved by the device's globalization data.
+/// </summary>
+public static class CountryPhoneDirectory
+{
+    private const string AssetName = "country-calling-codes.json";
+    public static async Task<IReadOnlyList<CountryPhoneOption>> LoadAsync(CancellationToken cancellationToken = default)
+    {
+        await using var stream = await FileSystem.OpenAppPackageFileAsync(AssetName);
+        var data = await JsonSerializer.DeserializeAsync(
+            stream, CountryPhoneDirectoryJsonContext.Default.CountryPhoneDirectoryData, cancellationToken);
+
+        if (data?.Countries is not { Count: > 0 })
+            throw new InvalidDataException("The bundled phone country directory is empty.");
+
+        var countries = new List<CountryPhoneOption>(data.Countries.Count);
+        foreach (var item in data.Countries)
+        {
+            if (string.IsNullOrWhiteSpace(item.IsoCode)
+                || string.IsNullOrWhiteSpace(item.CallingCode))
+                continue;
+
+            string displayName;
+            string englishName;
+            try
+            {
+                var region = new RegionInfo(item.IsoCode);
+                displayName = region.DisplayName;
+                englishName = region.EnglishName;
+            }
+            catch (ArgumentException)
+            {
+                // Some special regions in numbering metadata aren't recognized by
+                // every Android ICU release; keep them selectable by their ISO code.
+                displayName = item.IsoCode;
+                englishName = item.IsoCode;
+            }
+
+            countries.Add(new CountryPhoneOption(
+                item.IsoCode,
+                item.CallingCode,
+                item.NationalPrefix ?? string.Empty,
+                item.KeepNationalPrefix,
+                displayName,
+                englishName));
+        }
+
+        return countries
+            .OrderBy(country => country.DisplayName, StringComparer.CurrentCultureIgnoreCase)
+            .ToArray();
+    }
+
+    public static string GetDeviceRegionIsoCode()
+    {
+        try
+        {
+            var iso = RegionInfo.CurrentRegion.TwoLetterISORegionName;
+            return string.IsNullOrWhiteSpace(iso) ? "AE" : iso;
+        }
+        catch
+        {
+            var cultureRegion = CultureInfo.CurrentCulture.Name.Split('-').LastOrDefault();
+            return string.IsNullOrWhiteSpace(cultureRegion) ? "AE" : cultureRegion;
+        }
+    }
+
+}
