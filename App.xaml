<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:KaamLink"
             xmlns:presentation="clr-namespace:KaamLink.Core.Presentation"
             x:Class="KaamLink.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Shared converter instances (MAUI core has no boolean inverter — ours is in Core/Presentation). -->
            <presentation:InverseBoolConverter x:Key="InvertedBoolConverter" />
            <presentation:VerificationStateColorConverter x:Key="VerificationStateColorConverter" />
            <presentation:VerificationStateSoftColorConverter x:Key="VerificationStateSoftColorConverter" />
            <presentation:StatusColorConverter x:Key="StatusColorConverter" />
            <presentation:StatusSoftColorConverter x:Key="StatusSoftColorConverter" />
            <presentation:StringHasContentConverter x:Key="StringHasContent" />
            <presentation:CountPositiveConverter x:Key="CountPositive" />
            <presentation:StageColorConverter x:Key="StageColorConverter" />
            <presentation:CountEmptyConverter x:Key="CountEmpty" />
            <presentation:StringEqualsConverter x:Key="StringEquals" />
            <presentation:SelectedOptionBackgroundConverter x:Key="SelectedOptionBackground" />
            <presentation:SelectedOptionTextColorConverter x:Key="SelectedOptionText" />

            <ResourceDictionary.MergedDictionaries>
                <!-- Icons never change with a theme, so they sit outside the palette. -->
                <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
                <!-- The palette below is the ONLY themeable dictionary: IThemeService
                     replaces it in place when the user switches theme. -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
