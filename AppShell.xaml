<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="KaamLink.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:onboarding="clr-namespace:KaamLink.Features.Onboarding"
    FlyoutBehavior="Disabled">

    <!--
        Route names come from Core/Navigation/AppRoutes.cs — keep them in sync.
        Worker and Employer roots are registered in AppShell.xaml.cs via
        Routing.RegisterRoute until role-gated navigation lands with auth (Phase 02+).
    -->
    <ShellContent
        Route="welcome"
        ContentTemplate="{DataTemplate onboarding:RoleSelectionPage}" />
</Shell>
