<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Assessments"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Assessments.AssessmentRunPage"
             x:Name="Page"
             x:DataType="vm:AssessmentRunViewModel"
             Title="{Binding SkillName}"
             Shell.NavBarIsVisible="False">

    <!-- Single-shot, server-scored attempt. Options are selectable ROWS (radio
         style) rather than filled buttons, so the only filled control on screen
         is Submit. Selection state still comes from QuestionRowModel.IsSelected
         through the existing SelectedOptionBackground/SelectedOptionText keys. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Pinned back action: it must not scroll away on long screens. -->
        <Grid Grid.Row="0"
              Style="{StaticResource AppBar}"
              Padding="4,0">
            <Button Style="{StaticResource TextButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="48"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BackCta}"
                    Text="{x:Static strings:AppStrings.BackCta}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Style="{StaticResource PageStack}" Spacing="14">

                <controls:StatePanel Kind="loading"
                                     IsVisible="{Binding IsBusy}"
                                     Title="{x:Static strings:AppStrings.CommonLoading}" />

                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                    <controls:NoticeBanner Kind="danger"
                                           Title="{x:Static strings:AppStrings.CommonErrorTitle}"
                                           Message="{Binding ErrorMessage}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding StartCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                            Text="{x:Static strings:AppStrings.RetryCta}" />
                </VerticalStackLayout>

                <!-- Quiz -->
                <VerticalStackLayout IsVisible="{Binding IsQuizVisible}" Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource TitleText}"
                               Text="{Binding SkillName}" />
                        <Border Grid.Column="1"
                                Style="{StaticResource PillBorder}"
                                BackgroundColor="{DynamicResource WarningSoft}"
                                Stroke="{DynamicResource WarningBrush}"
                                VerticalOptions="Center">
                            <Label Style="{StaticResource PillText}"
                                   TextColor="{DynamicResource Warning}"
                                   Text="{Binding PassMarkText}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource SmallStrongText}"
                               Text="{Binding AnsweredCountText}" />
                        <ProgressBar Progress="{Binding AnsweredProgress}" />
                    </VerticalStackLayout>

                    <Label Style="{StaticResource CaptionText}"
                           Text="{x:Static strings:AppStrings.RunnerTapHint}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Questions}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuestionRowModel">
                                <Border Style="{StaticResource SurfaceCardDense}">
                                    <VerticalStackLayout Spacing="10">
                                        <Label Style="{StaticResource CardTitleText}"
                                               Text="{Binding Text}" />

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}"
                                                             Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OptionRowModel">
                                                    <Border BackgroundColor="{DynamicResource CardSurface}"
                                                            Stroke="{DynamicResource BorderBrush}"
                                                            StrokeThickness="1"
                                                            Padding="12"
                                                            SemanticProperties.Description="{Binding Text}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border"
                                                                         Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="BackgroundColor" Value="{DynamicResource PrimarySoft}" />
                                                                <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectOptionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                                                  CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Border Grid.Column="0"
                                                                    HeightRequest="22"
                                                                    WidthRequest="22"
                                                                    Padding="0"
                                                                    StrokeThickness="1"
                                                                    Stroke="{DynamicResource BorderStrongBrush}"
                                                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedOptionBackground}}"
                                                                    VerticalOptions="Start">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="18" />
                                                                </Border.StrokeShape>
                                                                <Label Style="{StaticResource IconGlyphOnPrimary}"
                                                                       FontSize="13"
                                                                       IsVisible="{Binding IsSelected}"
                                                                       Text="{StaticResource IconCheck}"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center" />
                                                            </Border>
                                                            <Label Grid.Column="1"
                                                                   Style="{StaticResource SmallText}"
                                                                   TextColor="{Binding IsSelected, Converter={StaticResource SelectedOptionText}}"
                                                                   Text="{Binding Text}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Style="{StaticResource CaptionText}"
                           Text="{x:Static strings:AppStrings.RunnerSubmitNote}" />
                </VerticalStackLayout>

                <!-- Server verdict -->
                <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="12">
                    <Border Style="{StaticResource SurfaceCard}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Style="{StaticResource IconTileLarge}"
                                        BackgroundColor="{Binding ResultState, Converter={StaticResource StatusSoftColorConverter}}">
                                    <Grid>
                                        <Label Style="{StaticResource IconGlyphPrimary}"
                                               FontSize="22"
                                               IsVisible="{Binding ResultPassed}"
                                               TextColor="{Binding ResultState, Converter={StaticResource StatusColorConverter}}"
                                               Text="{StaticResource IconCheckCircle}"
                                               HorizontalOptions="Center" />
                                        <Label Style="{StaticResource IconGlyphPrimary}"
                                               FontSize="22"
                                               IsVisible="{Binding ResultPassed, Converter={StaticResource InvertedBoolConverter}}"
                                               TextColor="{Binding ResultState, Converter={StaticResource StatusColorConverter}}"
                                               Text="{StaticResource IconX}"
                                               HorizontalOptions="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Style="{StaticResource CaptionText}"
                                           Text="{x:Static strings:AppStrings.RunnerResultEyebrow}" />
                                    <Label SemanticProperties.HeadingLevel="Level2"
                                           Style="{StaticResource TitleText}"
                                           TextColor="{Binding ResultState, Converter={StaticResource StatusColorConverter}}"
                                           Text="{Binding ResultTitle}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Style="{StaticResource BodyStrongText}"
                                   FontSize="16"
                                   Text="{Binding ResultScoreText}" />
                            <Label Style="{StaticResource SmallText}"
                                   Text="{Binding ResultNote}" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding DoneCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.AssessmentDoneCta}"
                            Text="{x:Static strings:AppStrings.AssessmentDoneCta}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              Style="{StaticResource BottomDock}"
              IsVisible="{Binding IsQuizVisible}">
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding SubmitCommand}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.AssessmentSubmitCta}"
                    Text="{x:Static strings:AppStrings.AssessmentSubmitCta}" />
        </Grid>
    </Grid>
</ContentPage>
