<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Assessments"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Assessments.MyAssessmentsPage"
             x:DataType="vm:MyAssessmentsViewModel"
             Title="{x:Static strings:AppStrings.AssessmentsTitle}">

    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="12">

        <ActivityIndicator Grid.Row="0"
                           HorizontalOptions="Center"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" />

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasError}" Spacing="10">
            <Label Style="{StaticResource Body}"
                   Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Error}" />
            <Button Command="{Binding LoadCommand}"
                    Text="{x:Static strings:AppStrings.RetryCta}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmpty}" Spacing="10">
            <Label Style="{StaticResource BodySecondary}"
                   Text="{x:Static strings:AppStrings.AssessmentsEmpty}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        IsVisible="{Binding IsLoaded}"
                        ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AssessmentRowModel">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Style="{StaticResource SectionTitle}"
                                       Text="{Binding SkillName}" />
                                <Border Grid.Column="1"
                                        Padding="10,3"
                                        Stroke="{Binding StateRaw, Converter={StaticResource StatusColorConverter}}"
                                        StrokeShape="RoundRectangle 12">
                                    <Label FontFamily="OpenSansSemibold"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding StateLabel}"
                                           TextColor="{Binding StateRaw, Converter={StaticResource StatusColorConverter}}" />
                                </Border>
                            </Grid>

                            <Label IsVisible="{Binding HasScore}"
                                   Style="{StaticResource BodySecondary}"
                                   Text="{Binding ScoreLine}" />

                            <Label IsVisible="{Binding Available, Converter={StaticResource InvertedBoolConverter}}"
                                   Style="{StaticResource Caption}"
                                   Text="{x:Static strings:AppStrings.AssessmentNotAvailable}" />

                            <Button Command="{Binding DataContext.OpenAssessmentCommand, Source={RelativeSource AncestorType={x:Type vm:MyAssessmentsViewModel}}}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding Available}"
                                    Text="{x:Static strings:AppStrings.AssessmentStartCta}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
