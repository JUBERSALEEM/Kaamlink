<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Assessments"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Assessments.MyAssessmentsPage"
             x:Name="Page"
             x:DataType="vm:MyAssessmentsViewModel"
             Title="{x:Static strings:AppStrings.AssessmentsTitle}"
             Shell.NavBarIsVisible="False">

    <!-- Skills the worker declared, with the server's assessment availability,
         verification state and last score. Nothing here is optimistically
         updated: a pass appears only after the server returns it. -->
    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,8" Spacing="8">
            <Button Style="{StaticResource TextButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="48"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BackCta}"
                    Text="{x:Static strings:AppStrings.BackCta}" />
            <Label SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource TitleText}"
                   Text="{x:Static strings:AppStrings.AssessmentsHeadline}" />
            <Label Style="{StaticResource BodyText}"
                   Text="{x:Static strings:AppStrings.AssessmentsBody}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="12">

                <controls:StatePanel Kind="loading"
                                     IsVisible="{Binding IsBusy}"
                                     Title="{x:Static strings:AppStrings.CommonLoading}" />

                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                    <controls:NoticeBanner Kind="danger"
                                           Title="{x:Static strings:AppStrings.CommonErrorTitle}"
                                           Message="{Binding ErrorMessage}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                            Text="{x:Static strings:AppStrings.RetryCta}" />
                </VerticalStackLayout>

                <controls:NoticeBanner Kind="info"
                                       IsVisible="{Binding IsLoaded}"
                                       Title="{x:Static strings:AppStrings.AssessmentsWhyTitle}"
                                       Message="{x:Static strings:AppStrings.AssessmentsWhyBody}" />

                <controls:StatePanel Kind="empty"
                                     IsVisible="{Binding IsEmpty}"
                                     Glyph="{StaticResource IconBadgeCheck}"
                                     Title="{x:Static strings:AppStrings.AssessmentsEmptyTitle}"
                                     Message="{x:Static strings:AppStrings.AssessmentsEmpty}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                     Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssessmentRowModel">
                            <Border Style="{StaticResource SurfaceCardDense}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource CardTitleText}"
                                               Text="{Binding SkillName}"
                                               VerticalOptions="Center" />
                                        <controls:StatusPill Grid.Column="1"
                                                             VerticalOptions="Center"
                                                             Text="{Binding StateLabel}"
                                                             Tone="{Binding StateRaw, Converter={StaticResource StatusColorConverter}}"
                                                             ToneSoft="{Binding StateRaw, Converter={StaticResource StatusSoftColorConverter}}" />
                                    </Grid>

                                    <Label IsVisible="{Binding HasScore}"
                                           Style="{StaticResource SmallText}"
                                           Text="{Binding ScoreLine}" />

                                    <Label IsVisible="{Binding Available, Converter={StaticResource InvertedBoolConverter}}"
                                           Style="{StaticResource CaptionText}"
                                           Text="{x:Static strings:AppStrings.AssessmentNotAvailable}" />

                                    <Button Style="{StaticResource SubtleButton}"
                                            Command="{Binding BindingContext.OpenAssessmentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding Available}"
                                            SemanticProperties.Description="{x:Static strings:AppStrings.AssessmentStartCta}"
                                            Text="{x:Static strings:AppStrings.AssessmentStartCta}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <controls:NoticeBanner Kind="success"
                                       IsVisible="{Binding IsLoaded}"
                                       Title="{x:Static strings:AppStrings.AssessmentsPrivacyTitle}"
                                       Message="{x:Static strings:AppStrings.AssessmentsPrivacyBody}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
