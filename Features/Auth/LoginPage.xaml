<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Auth"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{x:Static strings:AppStrings.LoginTitle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20"
                             VerticalOptions="Center">

            <VerticalStackLayout Spacing="8">
                <Label SemanticProperties.HeadingLevel="Level1"
                       Style="{StaticResource Title1}"
                       Text="{x:Static strings:AppStrings.LoginTitle}" />
                <Label Style="{StaticResource BodySecondary}"
                       Text="{x:Static strings:AppStrings.LoginSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}"
                           Text="{x:Static strings:AppStrings.PhoneLabel}" />
                    <Entry AutomationProperties.Name="{x:Static strings:AppStrings.PhoneLabel}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                           Keyboard="Telephone"
                           Placeholder="{x:Static strings:AppStrings.PhonePlaceholder}"
                           Text="{Binding Phone}" />
                    <Label IsVisible="{Binding HasError}"
                           Style="{StaticResource Caption}"
                           Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Error}" />
                    <Button Command="{Binding SendCodeCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.SendCodeCta}"
                            Text="{x:Static strings:AppStrings.SendCodeCta}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
