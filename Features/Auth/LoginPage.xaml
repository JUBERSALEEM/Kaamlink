<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Auth"
             xmlns:country="clr-namespace:KaamLink.Core.Text"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{x:Static strings:AppStrings.LoginTitle}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,28" Spacing="15">

                <!-- Logo and theme switch are separate, accessible native controls. -->
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
                    <Image Grid.Column="0"
                           Source="kaamlink_mark.svg"
                           HeightRequest="44"
                           WidthRequest="44"
                           Aspect="AspectFit"
                           SemanticProperties.Description="{x:Static strings:AppStrings.AppName}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                        <Label Style="{StaticResource SectionText}"
                               FontSize="18"
                               TextColor="{DynamicResource Primary}"
                               Text="{x:Static strings:AppStrings.AppName}" />
                        <Label Style="{StaticResource CaptionText}"
                               Text="{x:Static strings:AppStrings.AppTagline}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Style="{StaticResource ThemeToggleButton}"
                            InputTransparent="False"
                            Command="{Binding ToggleThemeCommand}"
                            SemanticProperties.Description="{Binding ThemeToggleLabel}"
                            Text="{Binding ThemeToggleLabel}" />
                </Grid>

                <VerticalStackLayout Spacing="6" Padding="0,2,0,0">
                    <Label SemanticProperties.HeadingLevel="Level1"
                           Style="{StaticResource DisplayText}"
                           Text="{x:Static strings:AppStrings.LoginWelcomeHeadline}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{x:Static strings:AppStrings.LoginWelcomeSubtitle}" />
                </VerticalStackLayout>

                <Border Background="{DynamicResource ClayCardBrush}"
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1"
                        Padding="6"
                        HeightRequest="124">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Image Source="login_hero.svg"
                           Aspect="AspectFit"
                           SemanticProperties.Description="{x:Static strings:AppStrings.LoginHeroDescription}" />
                </Border>

                <VerticalStackLayout Spacing="6">
                    <!-- OAuth is disabled until the server has an identity exchange endpoint. -->
                    <Button Style="{StaticResource SecondaryButton}"
                            IsEnabled="False"
                            SemanticProperties.Description="{x:Static strings:AppStrings.LoginContinueGoogle}"
                            Text="{x:Static strings:AppStrings.LoginContinueGoogle}" />
                    <Label Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppStrings.LoginGoogleSetupNote}" />
                </VerticalStackLayout>

                <!-- Normal sign-in: email OTP / password + phone OTP. -->
                <VerticalStackLayout Spacing="15"
                                    IsVisible="{Binding IsPasswordSetupPending, Converter={StaticResource InvertedBoolConverter}}">

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <BoxView Grid.Column="0" Style="{StaticResource DividerLine}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Style="{StaticResource CaptionText}"
                               Text="{x:Static strings:AppStrings.LoginOrEmail}" />
                        <BoxView Grid.Column="2" Style="{StaticResource DividerLine}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="7">
                        <Label Style="{StaticResource LabelText}"
                               Text="{x:Static strings:AppStrings.LoginEmailLabel}" />
                        <Border Style="{StaticResource FieldBox}" Padding="10,0">
                            <Grid MinimumHeightRequest="54">
                                <Entry AutomationProperties.Name="{x:Static strings:AppStrings.LoginEmailLabel}"
                                       BackgroundColor="Transparent"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                       Keyboard="Email"
                                       MaxLength="320"
                                       MinimumHeightRequest="52"
                                       Placeholder="{x:Static strings:AppStrings.LoginEmailPlaceholder}"
                                       ReturnType="Next"
                                       Text="{Binding Email}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Style="{StaticResource FieldHint}"
                               Text="{x:Static strings:AppStrings.LoginEmailHint}" />
                    </VerticalStackLayout>

                    <!-- Password is optional on first OTP signup; used for later sign-in. -->
                    <VerticalStackLayout Spacing="7"
                                        IsVisible="{Binding IsEmailCodePending, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Style="{StaticResource LabelText}"
                               Text="{x:Static strings:AppStrings.LoginPasswordLabel}" />
                        <Border Style="{StaticResource FieldBox}" Padding="10,0">
                            <Grid MinimumHeightRequest="54">
                                <Entry AutomationProperties.Name="{x:Static strings:AppStrings.LoginPasswordLabel}"
                                       BackgroundColor="Transparent"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                       IsPassword="True"
                                       MaxLength="128"
                                       MinimumHeightRequest="52"
                                       Placeholder="{x:Static strings:AppStrings.LoginPasswordPlaceholder}"
                                       ReturnType="Go"
                                       Text="{Binding Password}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8"
                                        IsVisible="{Binding IsEmailCodePending, Converter={StaticResource InvertedBoolConverter}}">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendEmailCodeCommand}"
                                InputTransparent="False"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                SemanticProperties.Description="{x:Static strings:AppStrings.LoginEmailSendLink}"
                                Text="{x:Static strings:AppStrings.LoginEmailSendLink}" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SignInWithPasswordCommand}"
                                InputTransparent="False"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                SemanticProperties.Description="{x:Static strings:AppStrings.LoginPasswordSignIn}"
                                Text="{x:Static strings:AppStrings.LoginPasswordSignIn}" />
                    </VerticalStackLayout>

                    <!-- Inline email OTP entry after the code is sent. -->
                    <VerticalStackLayout Spacing="7" IsVisible="{Binding IsEmailCodePending}">
                        <Label Style="{StaticResource LabelText}"
                               Text="{x:Static strings:AppStrings.LoginEmailOtpLabel}" />
                        <Border Style="{StaticResource FieldBox}" Padding="10,0">
                            <Grid MinimumHeightRequest="54">
                                <Entry AutomationProperties.Name="{x:Static strings:AppStrings.LoginEmailOtpLabel}"
                                       BackgroundColor="Transparent"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                       Keyboard="Numeric"
                                       MaxLength="8"
                                       MinimumHeightRequest="52"
                                       Placeholder="{x:Static strings:AppStrings.LoginEmailOtpPlaceholder}"
                                       ReturnType="Go"
                                       Text="{Binding EmailCode}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding VerifyEmailCodeCommand}"
                                InputTransparent="False"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                SemanticProperties.Description="{x:Static strings:AppStrings.LoginEmailVerifyCode}"
                                Text="{x:Static strings:AppStrings.LoginEmailVerifyCode}" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding HasInfo}"
                            SemanticProperties.Description="{Binding InfoTitle}"
                            BackgroundColor="{DynamicResource SuccessSoft}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   TextColor="{DynamicResource Success}"
                                   Text="{StaticResource IconCheckCircle}"
                                   VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Style="{StaticResource SmallStrongText}"
                                       TextColor="{DynamicResource Success}"
                                       Text="{Binding InfoTitle}" />
                                <Label Style="{StaticResource SmallText}"
                                       Text="{Binding InfoMessage}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <BoxView Grid.Column="0" Style="{StaticResource DividerLine}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Style="{StaticResource CaptionText}"
                               Text="{x:Static strings:AppStrings.LoginOrPhone}" />
                        <BoxView Grid.Column="2" Style="{StaticResource DividerLine}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="7">
                        <Label Style="{StaticResource LabelText}"
                               Text="{x:Static strings:AppStrings.PhoneLabel}" />
                        <Border Style="{StaticResource FieldBox}" Padding="8,0">
                            <Grid ColumnDefinitions="Auto,1,*" ColumnSpacing="10" MinimumHeightRequest="54">
                                <Button Grid.Column="0"
                                        Style="{StaticResource CountryPickerButton}"
                                        InputTransparent="False"
                                        Command="{Binding OpenCountryPickerCommand}"
                                        SemanticProperties.Description="{x:Static strings:AppStrings.PhoneCountryCodeDescription}"
                                        Text="{Binding SelectedCountryCode}" />
                                <BoxView Grid.Column="1"
                                         WidthRequest="1"
                                         HeightRequest="26"
                                         Color="{DynamicResource BorderStrong}"
                                         VerticalOptions="Center" />
                                <Entry Grid.Column="2"
                                       AutomationProperties.Name="{x:Static strings:AppStrings.PhoneLabel}"
                                       BackgroundColor="Transparent"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                       Keyboard="Telephone"
                                       MaxLength="18"
                                       Placeholder="{x:Static strings:AppStrings.PhonePlaceholder}"
                                       ReturnType="Go"
                                       Text="{Binding Phone}" />
                            </Grid>
                        </Border>
                        <Label Style="{StaticResource FieldHint}"
                               Text="{x:Static strings:AppStrings.LoginOtpHint}" />
                    </VerticalStackLayout>

                    <!-- One shared acceptance gate for every sign-in path. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinimumHeightRequest="48" Padding="0,2">
                        <CheckBox Grid.Column="0"
                                  Color="{DynamicResource Primary}"
                                  IsChecked="{Binding TermsAccepted}"
                                  MinimumHeightRequest="48"
                                  MinimumWidthRequest="48"
                                  SemanticProperties.Description="{x:Static strings:AppStrings.LoginTermsCheckbox}"
                                  VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Style="{StaticResource SmallText}"
                               Text="{x:Static strings:AppStrings.LoginTermsCheckbox}"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <Border IsVisible="{Binding HasError}"
                            BackgroundColor="{DynamicResource ErrorSoft}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   TextColor="{DynamicResource Error}"
                                   Text="{StaticResource IconAlertCircle}"
                                   VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Style="{StaticResource SmallStrongText}"
                                       TextColor="{DynamicResource Error}"
                                       Text="{Binding ErrorTitle}" />
                                <Label Style="{StaticResource SmallText}"
                                       Text="{Binding ErrorMessage}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding SendCodeCommand}"
                            InputTransparent="False"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.LoginPhoneContinue}"
                            Text="{x:Static strings:AppStrings.LoginPhoneContinue}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" />

                    <Label Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppStrings.WelcomeTermsNote}" />

                    <ActivityIndicator IsRunning="{Binding IsRestoringSession}"
                                       IsVisible="{Binding IsRestoringSession}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- After first OTP confirmation: optional password creation. -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsPasswordSetupPending}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Style="{StaticResource IconGlyphPrimary}"
                               Text="{StaticResource IconLock}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               SemanticProperties.HeadingLevel="Level2"
                               Style="{StaticResource SectionText}"
                               Text="{x:Static strings:AppStrings.LoginPasswordSetTitle}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Label Style="{StaticResource SmallText}"
                           Text="{x:Static strings:AppStrings.LoginPasswordSetHint}" />

                    <Label Style="{StaticResource LabelText}"
                           Text="{x:Static strings:AppStrings.LoginPasswordLabel}" />
                    <Border Style="{StaticResource FieldBox}" Padding="10,0">
                        <Grid MinimumHeightRequest="54">
                            <Entry AutomationProperties.Name="{x:Static strings:AppStrings.LoginPasswordLabel}"
                                   BackgroundColor="Transparent"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                   IsPassword="True"
                                   MaxLength="128"
                                   MinimumHeightRequest="52"
                                   Placeholder="{x:Static strings:AppStrings.LoginPasswordPlaceholder}"
                                   ReturnType="Next"
                                   Text="{Binding Password}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Style="{StaticResource LabelText}"
                           Text="{x:Static strings:AppStrings.LoginPasswordConfirmLabel}" />
                    <Border Style="{StaticResource FieldBox}" Padding="10,0">
                        <Grid MinimumHeightRequest="54">
                            <Entry AutomationProperties.Name="{x:Static strings:AppStrings.LoginPasswordConfirmLabel}"
                                   BackgroundColor="Transparent"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                   IsPassword="True"
                                   MaxLength="128"
                                   MinimumHeightRequest="52"
                                   Placeholder="{x:Static strings:AppStrings.LoginPasswordConfirmPlaceholder}"
                                   ReturnType="Go"
                                   Text="{Binding ConfirmPassword}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasError}"
                            BackgroundColor="{DynamicResource ErrorSoft}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   TextColor="{DynamicResource Error}"
                                   Text="{StaticResource IconAlertCircle}"
                                   VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Style="{StaticResource SmallStrongText}"
                                       TextColor="{DynamicResource Error}"
                                       Text="{Binding ErrorTitle}" />
                                <Label Style="{StaticResource SmallText}"
                                       Text="{Binding ErrorMessage}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SetPasswordCommand}"
                            InputTransparent="False"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.LoginPasswordSetButton}"
                            Text="{x:Static strings:AppStrings.LoginPasswordSetButton}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding SkipPasswordCommand}"
                            InputTransparent="False"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.LoginPasswordSkip}"
                            Text="{x:Static strings:AppStrings.LoginPasswordSkip}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Searchable, offline country picker overlay. -->
        <Grid ZIndex="10"
              IsVisible="{Binding IsCountryPickerVisible}"
              BackgroundColor="{DynamicResource Scrim}"
              Padding="18">
            <Border Style="{StaticResource SurfaceCard}"
                    VerticalOptions="Center"
                    MaximumHeightRequest="560"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               SemanticProperties.HeadingLevel="Level2"
                               Style="{StaticResource SectionText}"
                               Text="{x:Static strings:AppStrings.CountryPickerTitle}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource TextButton}"
                                Command="{Binding CloseCountryPickerCommand}"
                                SemanticProperties.Description="{x:Static strings:AppStrings.CloseCta}"
                                Text="{x:Static strings:AppStrings.CloseCta}" />
                    </Grid>
                    <Entry Grid.Row="1"
                           AutomationProperties.Name="{x:Static strings:AppStrings.CountrySearchLabel}"
                           Placeholder="{x:Static strings:AppStrings.CountrySearchLabel}"
                           Text="{Binding CountrySearchText}" />
                    <CollectionView Grid.Row="2"
                                    ItemsSource="{Binding FilteredCountries}"
                                    ItemSizingStrategy="MeasureFirstItem"
                                    ItemsUpdatingScrollMode="KeepScrollOffset"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource BodyText}"
                                   HorizontalTextAlignment="Center"
                                   Text="{x:Static strings:AppStrings.CountryNoResults}"
                                   Padding="12" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="country:CountryPhoneOption">
                                <Border Style="{StaticResource CountryListButton}"
                                        InputTransparent="False"
                                        SemanticProperties.Description="{Binding PickerLabel}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            NumberOfTapsRequired="1"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCountryCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource BodyStrongText}"
                                           InputTransparent="True"
                                           Text="{Binding PickerLabel}"
                                           TextColor="{DynamicResource Primary}"
                                           HorizontalTextAlignment="Start"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
