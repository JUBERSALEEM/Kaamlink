<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Auth"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Auth.OtpPage"
             x:DataType="vm:OtpViewModel"
             Title="{x:Static strings:AppStrings.OtpTitle}"
             Shell.NavBarIsVisible="False">

    <!-- OTP verification. The code entry is the hero; the resend action keeps the
         server-driven countdown and stays a text action so it never competes with
         "Verify". -->
    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,24" Spacing="16">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        Style="{StaticResource IconTile}"
                        VerticalOptions="Center">
                    <Label Style="{StaticResource IconGlyphPrimary}"
                           Text="{StaticResource IconLock}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Style="{StaticResource SectionText}"
                       FontSize="18"
                       TextColor="{StaticResource Primary}"
                       Text="{x:Static strings:AppStrings.AppName}"
                       VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="8" Padding="0,6,0,0">
                <Label SemanticProperties.HeadingLevel="Level1"
                       Style="{StaticResource TitleText}"
                       Text="{x:Static strings:AppStrings.OtpHeadline}" />
                <Label Style="{StaticResource BodyText}"
                       Text="{x:Static strings:AppStrings.OtpSentTo}" />
                <Label Style="{StaticResource BodyStrongText}"
                       FontSize="16"
                       Text="{Binding Phone}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Style="{StaticResource FormStack}">

                    <VerticalStackLayout Style="{StaticResource FieldStack}">
                        <Label Style="{StaticResource LabelText}"
                               Text="{x:Static strings:AppStrings.OtpCodeLabel}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Entry AutomationProperties.Name="{x:Static strings:AppStrings.OtpCodeLabel}"
                                   BackgroundColor="Transparent"
                                   CharacterSpacing="8"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22"
                                   HorizontalTextAlignment="Center"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                                   Keyboard="Numeric"
                                   MaxLength="6"
                                   Placeholder="••••••"
                                   Text="{Binding Code}" />
                        </Border>
                        <Label Style="{StaticResource FieldHint}"
                               Text="{x:Static strings:AppStrings.OtpExpiryNote}" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding CanResend, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource CardSurfaceAlt}"
                            StrokeThickness="0"
                            Padding="12,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   TextColor="{StaticResource Warning}"
                                   Text="{StaticResource IconClock}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource SmallText}"
                                   Text="{Binding ResendText}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Validation summary -->
                    <Border IsVisible="{Binding HasError}"
                            BackgroundColor="{StaticResource ErrorSoft}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   TextColor="{StaticResource Error}"
                                   Text="{StaticResource IconAlertCircle}"
                                   VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Style="{StaticResource SmallStrongText}"
                                       TextColor="{StaticResource Error}"
                                       Text="{x:Static strings:AppStrings.OtpErrorTitle}" />
                                <Label Style="{StaticResource SmallText}"
                                       Text="{Binding ErrorMessage}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding VerifyCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.VerifyCta}"
                            Text="{x:Static strings:AppStrings.VerifyCta}" />

                    <Button Style="{StaticResource TextButton}"
                            Command="{Binding ResendCommand}"
                            HorizontalOptions="Center"
                            IsEnabled="{Binding CanResend}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.ResendCta}"
                            Text="{x:Static strings:AppStrings.ResendCta}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Style="{StaticResource TextButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{x:Static strings:AppStrings.OtpWrongNumberNote}"
                    Text="{x:Static strings:AppStrings.OtpWrongNumberNote}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
