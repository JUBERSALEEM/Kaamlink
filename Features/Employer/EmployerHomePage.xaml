<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Employer"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Employer.EmployerHomePage"
             x:Name="Page"
             x:DataType="vm:EmployerHomeViewModel"
             Title="{x:Static strings:AppStrings.EmployerHomeTitle}"
             Shell.NavBarIsVisible="False">

    <!-- Employer home. Verification is the product's trust anchor, so each company
         card leads with its real server state (pending / verified / rejected) and
         the banner explains what happens next instead of hiding it in a pill. -->
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageStack}" Spacing="16">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalOptions="Center">
                    <Label Style="{StaticResource IconGlyphPrimary}"
                           Text="{StaticResource IconBuilding}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Style="{StaticResource SectionText}"
                       FontSize="18"
                       TextColor="{StaticResource Primary}"
                       Text="{x:Static strings:AppStrings.AppName}"
                       VerticalOptions="Center" />
                <Border Grid.Column="2" Style="{StaticResource PillBorder}" VerticalOptions="Center">
                    <Label Style="{StaticResource PillText}"
                           TextColor="{StaticResource Primary}"
                           Text="{x:Static strings:AppStrings.RoleEmployerPill}" />
                </Border>
            </Grid>

            <controls:StatePanel Kind="loading"
                                 IsVisible="{Binding IsBusy}"
                                 Title="{x:Static strings:AppStrings.CommonLoading}" />

            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                <controls:NoticeBanner Kind="danger"
                                       Title="{x:Static strings:AppStrings.CommonErrorTitle}"
                                       Message="{Binding ErrorMessage}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                        Text="{x:Static strings:AppStrings.RetryCta}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsLoaded}" Spacing="14">

                <VerticalStackLayout Spacing="4">
                    <Label SemanticProperties.HeadingLevel="Level1"
                           Style="{StaticResource TitleText}"
                           Text="{x:Static strings:AppStrings.EmployerDashboard}" />
                </VerticalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Companies}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompanyCardModel">
                            <Border Style="{StaticResource SurfaceCard}">
                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label SemanticProperties.HeadingLevel="Level2"
                                                   Style="{StaticResource CardTitleText}"
                                                   MaxLines="2"
                                                   Text="{Binding Name}" />
                                            <Label Style="{StaticResource CaptionText}"
                                                   Text="{Binding CategoryEmirateLine}" />
                                        </VerticalStackLayout>
                                        <controls:StatusPill Grid.Column="1"
                                                             VerticalOptions="Start"
                                                             Text="{Binding VerificationLabel}"
                                                             Tone="{Binding VerificationState, Converter={StaticResource VerificationStateColorConverter}}"
                                                             ToneSoft="{Binding VerificationState, Converter={StaticResource VerificationStateSoftColorConverter}}" />
                                    </Grid>

                                    <BoxView Style="{StaticResource DividerLine}" />

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource IconGlyph}"
                                               FontSize="15"
                                               Text="{StaticResource IconUserCheck}" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource CaptionText}"
                                               Text="{Binding RoleText}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <controls:NoticeBanner Kind="warning"
                                                           IsVisible="{Binding IsPending}"
                                                           Title="{x:Static strings:AppStrings.EmployerPendingTitle}"
                                                           Message="{x:Static strings:AppStrings.EmployerPendingBody}" />

                                    <controls:NoticeBanner Kind="success"
                                                           IsVisible="{Binding VerificationState, Converter={StaticResource StringEquals}, ConverterParameter=Verified}"
                                                           Title="{x:Static strings:AppStrings.EmployerVerifiedTitle}"
                                                           Message="{x:Static strings:AppStrings.EmployerVerifiedBody}" />

                                    <controls:NoticeBanner Kind="danger"
                                                           IsVisible="{Binding VerificationState, Converter={StaticResource StringEquals}, ConverterParameter=Rejected}"
                                                           Title="{x:Static strings:AppStrings.EmployerRejectedTitle}" />

                                    <Border IsVisible="{Binding HasReason}"
                                            BackgroundColor="{StaticResource ErrorSoft}"
                                            StrokeThickness="0"
                                            Padding="10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Style="{StaticResource SmallText}"
                                               TextColor="{StaticResource Error}"
                                               Text="{Binding VerificationReason}" />
                                    </Border>

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BindingContext.ManageVacanciesCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{x:Static strings:AppStrings.ManageVacanciesCta}"
                                            Text="{x:Static strings:AppStrings.ManageVacanciesCta}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Style="{StaticResource OverlineText}"
                       Margin="0,4,0,0"
                       Text="{x:Static strings:AppStrings.HomeAccountSection}" />
                <BoxView Style="{StaticResource DividerLine}" />
                <Button Style="{StaticResource TextButton}"
                        Command="{Binding SwitchToWorkerCommand}"
                        HorizontalOptions="Start"
                        SemanticProperties.Description="{x:Static strings:AppStrings.SwitchToWorkerCta}"
                        Text="{x:Static strings:AppStrings.SwitchToWorkerCta}" />
                <Button Style="{StaticResource TextButton}"
                        Command="{Binding LogoutCommand}"
                        HorizontalOptions="Start"
                        SemanticProperties.Description="{x:Static strings:AppStrings.LogoutCta}"
                        Text="{x:Static strings:AppStrings.LogoutCta}"
                        TextColor="{StaticResource Error}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
