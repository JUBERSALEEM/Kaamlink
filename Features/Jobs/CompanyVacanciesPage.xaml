<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Jobs"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Jobs.CompanyVacanciesPage"
             x:Name="Page"
             x:DataType="vm:CompanyVacanciesViewModel"
             Title="{x:Static strings:AppStrings.CompanyVacanciesTitle}"
             Shell.NavBarIsVisible="False">

    <!-- Employer vacancy management. Status is server-owned: the row shows the
         returned status, and the only status actions offered are the ones the
         server would accept (CanActivate / CanPause / CanClose). -->
    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,10" Spacing="2">
            <Button Style="{StaticResource TextButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="48"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BackCta}"
                    Text="{x:Static strings:AppStrings.BackCta}" />
            <!-- The company name arrives in the query string; if a deep link or a cold
                 back-stack omits it, fall back to the page's own name instead of
                 rendering an empty heading. -->
            <Label SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource TitleText}"
                   IsVisible="{Binding HasCompanyName}"
                   Text="{Binding CompanyName}" />
            <Label Style="{StaticResource SectionText}"
                   IsVisible="{Binding HasCompanyName, Converter={StaticResource InvertedBoolConverter}}"
                   Text="{x:Static strings:AppStrings.CompanyVacanciesTitle}" />
            <Label Style="{StaticResource CaptionText}"
                   IsVisible="{Binding HasCompanyName}"
                   Text="{x:Static strings:AppStrings.CompanyVacanciesTitle}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,0,16,24" Spacing="12">

                <controls:StatePanel Kind="loading"
                                     IsVisible="{Binding IsBusy}"
                                     Title="{x:Static strings:AppStrings.CommonLoading}" />

                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                    <controls:NoticeBanner Kind="danger"
                                           Title="{x:Static strings:AppStrings.CommonErrorTitle}"
                                           Message="{Binding ErrorMessage}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                            Text="{x:Static strings:AppStrings.RetryCta}" />
                </VerticalStackLayout>

                <controls:StatePanel Kind="empty"
                                     IsVisible="{Binding IsEmpty}"
                                     Glyph="{StaticResource IconBriefcase}"
                                     Title="{x:Static strings:AppStrings.CompanyVacanciesEmptyTitle}"
                                     Message="{x:Static strings:AppStrings.CompanyVacanciesEmpty}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmployerVacancyRowModel">
                            <Border Style="{StaticResource SurfaceCard}">
                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               SemanticProperties.HeadingLevel="Level2"
                                               Style="{StaticResource CardTitleText}"
                                               MaxLines="2"
                                               Text="{Binding Title}" />
                                        <controls:StatusPill Grid.Column="1"
                                                             VerticalOptions="Start"
                                                             Text="{Binding StatusLabel}"
                                                             Tone="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                             ToneSoft="{Binding Status, Converter={StaticResource StatusSoftColorConverter}}" />
                                    </Grid>

                                    <Label Style="{StaticResource CaptionText}"
                                           Text="{Binding MetaLine}" />

                                    <BoxView Style="{StaticResource DividerLine}" />

                                    <Button Style="{StaticResource TextButton}"
                                            Command="{Binding BindingContext.OpenApplicationsCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            HorizontalOptions="Start"
                                            SemanticProperties.Description="{x:Static strings:AppStrings.VacancyApplicationsTitle}"
                                            Text="{Binding ApplicationsCountText}" />

                                    <!-- Wraps instead of overflowing: Arabic labels are
                                         longer than the English ones at 320dp. -->
                                    <FlexLayout Direction="Row"
                                                Wrap="Wrap"
                                                JustifyContent="Start"
                                                AlignItems="Start">
                                        <Button Style="{StaticResource SubtleButton}"
                                                Command="{Binding BindingContext.ActivateCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanActivate}"
                                                Margin="0,0,8,8"
                                                SemanticProperties.Description="{x:Static strings:AppStrings.ActivateCta}"
                                                Text="{x:Static strings:AppStrings.ActivateCta}" />
                                        <Button Style="{StaticResource SubtleButton}"
                                                Command="{Binding BindingContext.PauseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanPause}"
                                                Margin="0,0,8,8"
                                                SemanticProperties.Description="{x:Static strings:AppStrings.PauseCta}"
                                                Text="{x:Static strings:AppStrings.PauseCta}" />
                                        <Button Style="{StaticResource DangerButton}"
                                                Command="{Binding BindingContext.CloseCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanClose}"
                                                Margin="0,0,8,8"
                                                SemanticProperties.Description="{x:Static strings:AppStrings.CloseCta}"
                                                Text="{x:Static strings:AppStrings.CloseCta}" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- New vacancy is the primary task on this screen, so it is pinned. -->
        <Grid Grid.Row="2" Style="{StaticResource BottomDock}">
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding NewVacancyCommand}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.NewVacancyCta}"
                    Text="{x:Static strings:AppStrings.NewVacancyCta}" />
        </Grid>
    </Grid>
</ContentPage>
