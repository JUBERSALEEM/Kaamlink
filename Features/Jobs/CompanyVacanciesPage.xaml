<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Jobs"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Jobs.CompanyVacanciesPage"
             x:Name="Page"
             x:DataType="vm:CompanyVacanciesViewModel"
             Title="{x:Static strings:AppStrings.CompanyVacanciesTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       SemanticProperties.HeadingLevel="Level1"
                       Style="{StaticResource Title1}"
                       Text="{Binding CompanyName}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Command="{Binding NewVacancyCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.NewVacancyCta}"
                        Text="{x:Static strings:AppStrings.NewVacancyCta}" />
            </Grid>

            <ActivityIndicator HorizontalOptions="Center"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="12">
                <Label Style="{StaticResource Body}"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}" />
                <Button Command="{Binding LoadCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                        Text="{x:Static strings:AppStrings.RetryCta}" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource BodySecondary}"
                   Text="{x:Static strings:AppStrings.CompanyVacanciesEmpty}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:EmployerVacancyRowModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           SemanticProperties.HeadingLevel="Level2"
                                           Style="{StaticResource SectionTitle}"
                                           Text="{Binding Title}" />
                                    <Border Grid.Column="1"
                                            Padding="10,3"
                                            Stroke="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            StrokeShape="RoundRectangle 12">
                                        <Label FontFamily="OpenSansSemibold"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding StatusLabel}"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                </Grid>

                                <Label Style="{StaticResource BodySecondary}"
                                       Text="{Binding MetaLine}" />

                                <Button BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.OpenApplicationsCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding}"
                                        HorizontalOptions="Start"
                                        Padding="0"
                                        SemanticProperties.Description="{x:Static strings:AppStrings.VacancyApplicationsTitle}"
                                        Text="{Binding ApplicationsCountText}"
                                        TextColor="{StaticResource Primary}" />

                                <HorizontalStackLayout Spacing="8">
                                    <Button Command="{Binding BindingContext.ActivateCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanActivate}"
                                            Text="{x:Static strings:AppStrings.ActivateCta}" />
                                    <Button Command="{Binding BindingContext.PauseCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanPause}"
                                            Text="{x:Static strings:AppStrings.PauseCta}" />
                                    <Button BackgroundColor="Transparent"
                                            Command="{Binding BindingContext.CloseCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanClose}"
                                            Text="{x:Static strings:AppStrings.CloseCta}"
                                            TextColor="{StaticResource Error}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
