<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Jobs"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Jobs.MyApplicationsPage"
             x:Name="Page"
             x:DataType="vm:MyApplicationsViewModel"
             Title="{x:Static strings:AppStrings.MyApplicationsTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <ActivityIndicator HorizontalOptions="Center"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="12">
                <Label Style="{StaticResource Body}"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}" />
                <Button Command="{Binding LoadCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                        Text="{x:Static strings:AppStrings.RetryCta}" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource BodySecondary}"
                   Text="{x:Static strings:AppStrings.MyApplicationsEmpty}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplicationRowModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           SemanticProperties.HeadingLevel="Level2"
                                           Style="{StaticResource SectionTitle}"
                                           Text="{Binding VacancyTitle}" />
                                    <Border Grid.Column="1"
                                            Padding="10,3"
                                            Stroke="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            StrokeShape="RoundRectangle 12">
                                        <Label FontFamily="OpenSansSemibold"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding StatusLabel}"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource BodySecondary}"
                                           Text="{Binding CompanyName}" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding AppliedDate}" />
                                </Grid>
                                <Button BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.WithdrawCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding}"
                                        HorizontalOptions="Start"
                                        IsVisible="{Binding CanWithdraw}"
                                        SemanticProperties.Description="{x:Static strings:AppStrings.WithdrawCta}"
                                        Text="{x:Static strings:AppStrings.WithdrawCta}"
                                        TextColor="{StaticResource Error}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
