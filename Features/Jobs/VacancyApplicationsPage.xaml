<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Jobs"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Jobs.VacancyApplicationsPage"
             x:Name="Page"
             x:DataType="vm:VacancyApplicationsViewModel"
             Title="{x:Static strings:AppStrings.VacancyApplicationsTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource Title1}"
                   Text="{Binding VacancyTitle}" />

            <ActivityIndicator HorizontalOptions="Center"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="12">
                <Label Style="{StaticResource Body}"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}" />
                <Button Command="{Binding LoadCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                        Text="{x:Static strings:AppStrings.RetryCta}" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource BodySecondary}"
                   Text="{x:Static strings:AppStrings.ApplicantsEmpty}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ApplicantRowModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           SemanticProperties.HeadingLevel="Level2"
                                           Style="{StaticResource SectionTitle}"
                                           Text="{Binding WorkerDisplayName}" />
                                    <Border Grid.Column="1"
                                            Padding="10,3"
                                            Stroke="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                            StrokeShape="RoundRectangle 12">
                                        <Label FontFamily="OpenSansSemibold"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding StatusLabel}"
                                               TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Border>
                                </Grid>

                                <Label FontFamily="OpenSansSemibold"
                                       Style="{StaticResource Body}"
                                       Text="{Binding WorkerPhoneNumber}" />
                                <Label Style="{StaticResource BodySecondary}"
                                       Text="{Binding MetaLine}" />

                                <VerticalStackLayout IsVisible="{Binding HasCoverNote}" Spacing="2">
                                    <Label Style="{StaticResource Caption}"
                                           Text="{x:Static strings:AppStrings.CoverNoteLabel}" />
                                    <Label Style="{StaticResource Body}"
                                           Text="{Binding CoverNote}" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout IsVisible="{Binding CanDecide}" Spacing="8">
                                    <Button BackgroundColor="Transparent"
                                            Command="{Binding BindingContext.MarkViewedCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanMarkViewed}"
                                            Text="{x:Static strings:AppStrings.ActionMarkViewed}"
                                            TextColor="{StaticResource Primary}" />
                                    <Button Command="{Binding BindingContext.ShortlistCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            Text="{x:Static strings:AppStrings.ActionShortlist}" />
                                    <Button Command="{Binding BindingContext.HireCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            Text="{x:Static strings:AppStrings.ActionHire}" />
                                    <Button BackgroundColor="Transparent"
                                            Command="{Binding BindingContext.RejectCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding}"
                                            Text="{x:Static strings:AppStrings.ActionReject}"
                                            TextColor="{StaticResource Error}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
