<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Jobs"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Jobs.VacancyDetailPage"
             x:DataType="vm:VacancyDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <!-- Vacancy detail + apply. The apply panel only renders when the server says
         the worker can apply (CanApply); once an application exists the banner
         shows the server's own status instead. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Pinned back action: it must not scroll away on long screens. -->
        <Grid Grid.Row="0"
              Style="{StaticResource AppBar}"
              Padding="4,0">
            <Button Style="{StaticResource TextButton}"
                    Command="{Binding BackCommand}"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="48"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BackCta}"
                    Text="{x:Static strings:AppStrings.BackCta}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Style="{StaticResource PageStack}" Spacing="14">

                <controls:StatePanel Kind="loading"
                                     IsVisible="{Binding IsBusy}"
                                     Title="{x:Static strings:AppStrings.CommonLoading}" />

                <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                    <controls:NoticeBanner Kind="danger"
                                           Title="{x:Static strings:AppStrings.CommonErrorTitle}"
                                           Message="{Binding ErrorMessage}" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                            Text="{x:Static strings:AppStrings.RetryCta}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsLoaded}" Spacing="14">

                    <!-- Head -->
                    <VerticalStackLayout Spacing="8">
                        <Label SemanticProperties.HeadingLevel="Level1"
                               Style="{StaticResource TitleText}"
                               Text="{Binding Title}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalOptions="Center">
                                <Label Style="{StaticResource IconGlyphPrimary}"
                                       FontSize="17"
                                       Text="{StaticResource IconBuilding}"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Style="{StaticResource BodyStrongText}"
                                   Text="{Binding CompanyLine}"
                                   VerticalOptions="Center" />
                            <controls:StatusPill Grid.Column="2"
                                                 VerticalOptions="Center"
                                                 Glyph="{StaticResource IconBadgeCheck}"
                                                 Text="{Binding CompanyVerificationLabel}"
                                                 Tone="{Binding CompanyVerificationState, Converter={StaticResource VerificationStateColorConverter}}"
                                                 ToneSoft="{Binding CompanyVerificationState, Converter={StaticResource VerificationStateSoftColorConverter}}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Meta -->
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Style="{StaticResource IconGlyph}"
                                       Text="{StaticResource IconPin}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Style="{StaticResource CaptionText}"
                                           Text="{x:Static strings:AppStrings.DetailLocationLabel}" />
                                    <Label Style="{StaticResource BodyStrongText}"
                                           Text="{Binding LocationLine}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Style="{StaticResource IconGlyph}"
                                       Text="{StaticResource IconBanknote}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Style="{StaticResource CaptionText}"
                                           Text="{x:Static strings:AppStrings.DetailSalaryLabel}" />
                                    <Label Style="{StaticResource BodyStrongText}"
                                           Text="{Binding SalaryText}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Style="{StaticResource IconGlyph}"
                                       Text="{StaticResource IconUsers}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Style="{StaticResource CaptionText}"
                                           Text="{x:Static strings:AppStrings.DetailOpeningsLabel}" />
                                    <Label Style="{StaticResource BodyStrongText}"
                                           Text="{Binding HeadcountText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Skills -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource OverlineText}"
                               Text="{x:Static strings:AppStrings.DetailSkillsTitle}" />
                        <Label Style="{StaticResource BodyText}"
                               Text="{Binding SkillsLine}" />
                    </VerticalStackLayout>

                    <!-- Description -->
                    <VerticalStackLayout IsVisible="{Binding HasDescription}" Spacing="8">
                        <Label Style="{StaticResource OverlineText}"
                               Text="{x:Static strings:AppStrings.DetailAboutTitle}" />
                        <Label Style="{StaticResource BodyText}"
                               Text="{Binding Description}" />
                    </VerticalStackLayout>

                    <!-- Own application (server truth) -->
                    <Border IsVisible="{Binding HasOwnApplication}"
                            Background="{DynamicResource ClayCardSoftBrush}"
                            Stroke="{DynamicResource ClayHighlightBrush}"
                            StrokeThickness="1"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   Text="{StaticResource IconCheckCircle}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource SmallText}"
                                   Text="{x:Static strings:AppStrings.DetailAppliedNote}"
                                   VerticalOptions="Center" />
                            <controls:StatusPill Grid.Column="2"
                                                 VerticalOptions="Center"
                                                 Text="{Binding OwnApplicationLabel}"
                                                 Tone="{Binding OwnApplicationStatus, Converter={StaticResource StatusColorConverter}}"
                                                 ToneSoft="{Binding OwnApplicationStatus, Converter={StaticResource StatusSoftColorConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Apply -->
                    <VerticalStackLayout IsVisible="{Binding CanApply}" Spacing="10">
                        <Label Style="{StaticResource OverlineText}"
                               Text="{x:Static strings:AppStrings.DetailNoteTitle}" />
                        <Border Style="{StaticResource FieldBox}" Padding="12,6">
                            <Editor AutomationProperties.Name="{x:Static strings:AppStrings.DetailNoteTitle}"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    MinimumHeightRequest="90"
                                    Placeholder="{x:Static strings:AppStrings.DetailCoverNotePlaceholder}"
                                    Text="{Binding CoverNote}" />
                        </Border>
                        <Label Style="{StaticResource CaptionText}"
                               Text="{x:Static strings:AppStrings.DetailOneApplicationNote}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky apply action -->
        <Grid Grid.Row="2"
              Style="{StaticResource BottomDock}"
              IsVisible="{Binding CanApply}">
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.ApplyCta}"
                    Text="{x:Static strings:AppStrings.ApplyCta}" />
        </Grid>
    </Grid>
</ContentPage>
