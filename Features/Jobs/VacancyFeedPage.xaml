<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Jobs"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Jobs.VacancyFeedPage"
             x:Name="Page"
             x:DataType="vm:VacancyFeedViewModel"
             Title="{x:Static strings:AppStrings.FeedTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Filters -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Entry Grid.Column="0"
                       Placeholder="{x:Static strings:AppStrings.FeedSearchPlaceholder}"
                       ReturnType="Search"
                       Text="{Binding SearchText}" />
                <Button Grid.Column="1"
                        Command="{Binding SearchCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.FeedSearchCta}"
                        Text="{x:Static strings:AppStrings.FeedSearchCta}" />
            </Grid>
            <Picker ItemDisplayBinding="{Binding Label}"
                    ItemsSource="{Binding EmirateOptions}"
                    SelectedItem="{Binding SelectedEmirate}" />

            <ActivityIndicator HorizontalOptions="Center"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="12">
                <Label Style="{StaticResource Body}"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Error}" />
                <Button Command="{Binding SearchCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                        Text="{x:Static strings:AppStrings.RetryCta}" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding IsEmpty}"
                   Style="{StaticResource BodySecondary}"
                   Text="{x:Static strings:AppStrings.FeedEmpty}" />

            <!-- Vacancy cards -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:VacancyCardModel">
                        <Border Style="{StaticResource Card}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenVacancyCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label SemanticProperties.HeadingLevel="Level2"
                                       Style="{StaticResource SectionTitle}"
                                       Text="{Binding Title}" />
                                <Label FontFamily="OpenSansSemibold"
                                       Style="{StaticResource Body}"
                                       Text="{Binding CompanyLine}" />
                                <Label Style="{StaticResource BodySecondary}"
                                       Text="{Binding LocationLine}" />
                                <Label Style="{StaticResource Body}"
                                       Text="{Binding SalaryText}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding SkillsLine}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding HeadcountText}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding HasMore}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.FeedLoadMoreCta}"
                    Text="{x:Static strings:AppStrings.FeedLoadMoreCta}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
