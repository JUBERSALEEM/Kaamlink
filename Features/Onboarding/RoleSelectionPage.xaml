<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Onboarding"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Onboarding.RoleSelectionPage"
             x:DataType="vm:RoleSelectionViewModel"
             Title="{x:Static strings:AppStrings.AppName}"
             Shell.NavBarIsVisible="False">

    <!-- Compact mobile role chooser; sign-in is the app's cold-start screen. -->
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,24" Spacing="16">

            <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                <Image Grid.Column="0"
                       Source="kaamlink_mark.svg"
                       HeightRequest="42"
                       WidthRequest="42"
                       Aspect="AspectFit"
                       SemanticProperties.Description="{x:Static strings:AppStrings.AppName}" />
                <Label Grid.Column="1"
                       Style="{StaticResource SectionText}"
                       FontSize="18"
                       TextColor="{DynamicResource Primary}"
                       Text="{x:Static strings:AppStrings.AppName}"
                       VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Style="{StaticResource ThemeToggleButton}"
                        Command="{Binding ToggleThemeCommand}"
                        SemanticProperties.Description="{Binding ThemeToggleLabel}"
                        Text="{Binding ThemeToggleLabel}" />
            </Grid>

            <VerticalStackLayout Spacing="6" Padding="0,2,0,2">
                <Label SemanticProperties.HeadingLevel="Level1"
                       Style="{StaticResource DisplayText}"
                       Text="{x:Static strings:AppStrings.WelcomeHeadline}" />
                <Label Style="{StaticResource BodyText}"
                       Text="{x:Static strings:AppStrings.WelcomeBody}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Start" />

            <Border Style="{StaticResource SurfaceCardDense}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                Style="{StaticResource IconTileLarge}"
                                BackgroundColor="{DynamicResource AccentSoft}"
                                VerticalOptions="Start">
                            <Label Style="{StaticResource IconGlyphPrimary}"
                                   FontSize="22"
                                   TextColor="{DynamicResource Accent}"
                                   Text="{StaticResource IconHardHat}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label SemanticProperties.HeadingLevel="Level2"
                                   Style="{StaticResource SectionText}"
                                   Text="{x:Static strings:AppStrings.RoleWorkerTitle}" />
                            <Label Style="{StaticResource SmallText}"
                                   Text="{x:Static strings:AppStrings.RoleWorkerCardBody}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToWorkerCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.WorkerOnboardingCta}"
                            Text="{x:Static strings:AppStrings.WorkerOnboardingCta}" />
                    <Label Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppStrings.WelcomeFreeNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCardDense}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                Style="{StaticResource IconTileLarge}"
                                VerticalOptions="Start">
                            <Label Style="{StaticResource IconGlyphPrimary}"
                                   FontSize="22"
                                   Text="{StaticResource IconBuilding}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label SemanticProperties.HeadingLevel="Level2"
                                   Style="{StaticResource SectionText}"
                                   Text="{x:Static strings:AppStrings.RoleEmployerTitle}" />
                            <Label Style="{StaticResource SmallText}"
                                   Text="{x:Static strings:AppStrings.RoleEmployerCardBody}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding NavigateToEmployerCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.EmployerOnboardingCta}"
                            Text="{x:Static strings:AppStrings.EmployerOnboardingCta}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource CaptionText}"
                   HorizontalTextAlignment="Center"
                   Text="{x:Static strings:AppStrings.WelcomeTermsNote}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
