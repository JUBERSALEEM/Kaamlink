<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Onboarding"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             x:Class="KaamLink.Features.Onboarding.RoleSelectionPage"
             x:DataType="vm:RoleSelectionViewModel"
             Title="{x:Static strings:AppStrings.AppName}"
             Shell.NavBarIsVisible="False">

    <!-- Mobile-first role chooser. Soft depth supports hierarchy; text, strokes,
         and native buttons remain the actual affordances. -->
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="15">

            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
                <Image Grid.Column="0"
                       Source="kaamlink_mark.svg"
                       HeightRequest="44"
                       WidthRequest="44"
                       Aspect="AspectFit"
                       SemanticProperties.Description="{x:Static strings:AppStrings.AppName}" />
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Style="{StaticResource SectionText}"
                           FontSize="18"
                           TextColor="{DynamicResource Primary}"
                           Text="{x:Static strings:AppStrings.AppName}" />
                    <Label Style="{StaticResource CaptionText}"
                           Text="{x:Static strings:AppStrings.AppTagline}" />
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        Style="{StaticResource ThemeToggleButton}"
                        Command="{Binding ToggleThemeCommand}"
                        SemanticProperties.Description="{Binding ThemeToggleLabel}"
                        Text="{Binding ThemeToggleLabel}" />
            </Grid>

            <VerticalStackLayout Spacing="6" Padding="0,2,0,0">
                <Label SemanticProperties.HeadingLevel="Level1"
                       Style="{StaticResource DisplayText}"
                       Text="{x:Static strings:AppStrings.LoginWelcomeHeadline}" />
                <Label Style="{StaticResource BodyText}"
                       Text="{x:Static strings:AppStrings.LoginWelcomeSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource LoginHeroSurface}">
                <Image Source="login_hero.svg"
                       Aspect="AspectFit"
                       SemanticProperties.Description="{x:Static strings:AppStrings.LoginHeroDescription}" />
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Start" />

            <Border Style="{StaticResource WorkerChoiceSurface}">
                <VerticalStackLayout Spacing="13">
                    <Grid ColumnDefinitions="60,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                Style="{StaticResource IconTileLarge}"
                                HeightRequest="60"
                                WidthRequest="60"
                                BackgroundColor="{DynamicResource PrimarySoft}"
                                VerticalOptions="Start">
                            <Label Style="{StaticResource IconGlyphPrimary}"
                                   FontSize="22"
                                   TextColor="{DynamicResource Accent}"
                                   Text="{StaticResource IconHardHat}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label SemanticProperties.HeadingLevel="Level2"
                                   Style="{StaticResource TitleText}"
                                   Text="{x:Static strings:AppStrings.RoleWorkerTitle}" />
                            <Label Style="{StaticResource BodyText}"
                                   Text="{x:Static strings:AppStrings.RoleWorkerCardBody}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToWorkerCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.WorkerOnboardingCta}"
                            Text="{x:Static strings:AppStrings.WorkerOnboardingCta}" />
                    <Label Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppStrings.WelcomeFreeNote}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EmployerChoiceSurface}">
                <VerticalStackLayout Spacing="13">
                    <Grid ColumnDefinitions="60,*" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                Style="{StaticResource IconTileLarge}"
                                HeightRequest="60"
                                WidthRequest="60"
                                BackgroundColor="{DynamicResource AccentSoft}"
                                VerticalOptions="Start">
                            <Label Style="{StaticResource IconGlyphPrimary}"
                                   FontSize="22"
                                   TextColor="{DynamicResource Accent}"
                                   Text="{StaticResource IconBuilding}"
                                   HorizontalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label SemanticProperties.HeadingLevel="Level2"
                                   Style="{StaticResource TitleText}"
                                   Text="{x:Static strings:AppStrings.RoleEmployerTitle}" />
                            <Label Style="{StaticResource BodyText}"
                                   Text="{x:Static strings:AppStrings.RoleEmployerCardBody}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Style="{StaticResource SecondaryButton}"
                            TextColor="{DynamicResource Accent}"
                            BorderColor="{DynamicResource Accent}"
                            Command="{Binding NavigateToEmployerCommand}"
                            SemanticProperties.Description="{x:Static strings:AppStrings.EmployerOnboardingCta}"
                            Text="{x:Static strings:AppStrings.EmployerOnboardingCta}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource CaptionText}"
                   HorizontalTextAlignment="Center"
                   Text="{x:Static strings:AppStrings.WelcomeTermsNote}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
