<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Worker"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Worker.WorkerHomePage"
             x:DataType="vm:WorkerHomeViewModel"
             Title="{x:Static strings:AppStrings.WorkerHomeTitle}"
             Shell.NavBarIsVisible="False">

    <!-- Worker home = the live Skill Passport. Every value below is server data
         from GET /workers/me; the only static copy is explanatory. -->
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageStack}" Spacing="16">

            <!-- Brand row -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource IconTile}" VerticalOptions="Center">
                    <Label Style="{StaticResource IconGlyphPrimary}"
                           Text="{StaticResource IconHardHat}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Grid.Column="1"
                       Style="{StaticResource SectionText}"
                       FontSize="18"
                       TextColor="{DynamicResource Primary}"
                       Text="{x:Static strings:AppStrings.AppName}"
                       VerticalOptions="Center" />
                <Border Grid.Column="2" Style="{StaticResource PillBorder}" VerticalOptions="Center">
                    <Label Style="{StaticResource PillText}"
                           TextColor="{DynamicResource Primary}"
                           Text="{x:Static strings:AppStrings.RoleWorkerPill}" />
                </Border>
            </Grid>

            <controls:StatePanel Kind="loading"
                                 IsVisible="{Binding IsBusy}"
                                 Title="{x:Static strings:AppStrings.CommonLoading}" />

            <!-- Error -->
            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="10">
                <controls:NoticeBanner Kind="danger"
                                       Title="{x:Static strings:AppStrings.CommonErrorTitle}"
                                       Message="{Binding ErrorMessage}" />
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}"
                        SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                        Text="{x:Static strings:AppStrings.RetryCta}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsLoaded}" Spacing="16">

                <!-- Identity + completeness -->
                <Border Style="{StaticResource SurfaceCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{DynamicResource PrimarySoft}"
                                    StrokeThickness="0"
                                    HeightRequest="48"
                                    WidthRequest="48"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label Style="{StaticResource IconGlyphPrimary}"
                                       FontSize="22"
                                       Text="{StaticResource IconUser}"
                                       HorizontalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label SemanticProperties.HeadingLevel="Level1"
                                       Style="{StaticResource TitleText}"
                                       FontSize="19"
                                       Text="{Binding DisplayName}" />
                                <Label Style="{StaticResource SmallText}"
                                       Text="{Binding Headline}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView Style="{StaticResource DividerLine}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource SmallStrongText}"
                                   Text="{Binding CompletenessText}" />
                            <ProgressBar Progress="{Binding CompletenessProgress}" />
                            <Label Style="{StaticResource CaptionText}"
                                   Text="{x:Static strings:AppStrings.HomeCompletenessNote}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick actions: whole tiles are the touch targets -->
                <Label Style="{StaticResource OverlineText}"
                       Text="{x:Static strings:AppStrings.HomeQuickActions}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                    <Border Grid.Column="0" Style="{StaticResource SurfaceCardDense}" Padding="10"
                            SemanticProperties.Description="{x:Static strings:AppStrings.HomeBrowseJobsCta}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BrowseJobsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource IconTile}" HorizontalOptions="Start">
                                <Label Style="{StaticResource IconGlyphPrimary}"
                                       Text="{StaticResource IconBriefcase}"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Label Style="{StaticResource SmallStrongText}"
                                   FontSize="12.5"
                                   Text="{x:Static strings:AppStrings.HomeBrowseJobsCta}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SurfaceCardDense}" Padding="10"
                            SemanticProperties.Description="{x:Static strings:AppStrings.MyApplicationsTitle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMyApplicationsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource IconTile}" HorizontalOptions="Start">
                                <Label Style="{StaticResource IconGlyphPrimary}"
                                       Text="{StaticResource IconClipboard}"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Label Style="{StaticResource SmallStrongText}"
                                   FontSize="12.5"
                                   Text="{x:Static strings:AppStrings.MyApplicationsTitle}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfaceCardDense}" Padding="10"
                            SemanticProperties.Description="{x:Static strings:AppStrings.MyAssessmentsCta}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenMyAssessmentsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource IconTile}"
                                    BackgroundColor="{DynamicResource AccentSoft}"
                                    HorizontalOptions="Start">
                                <Label Style="{StaticResource IconGlyphPrimary}"
                                       TextColor="{DynamicResource Accent}"
                                       Text="{StaticResource IconBadgeCheck}"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Label Style="{StaticResource SmallStrongText}"
                                   FontSize="12.5"
                                   Text="{x:Static strings:AppStrings.MyAssessmentsCta}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Skill Passport -->
                <Label Style="{StaticResource OverlineText}"
                       Text="{x:Static strings:AppStrings.SkillsSectionTitle}" />

                <Border Style="{StaticResource SurfaceCardDense}">
                    <VerticalStackLayout Spacing="0">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Skills}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SkillRowModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="10"
                                          Padding="0,10">
                                        <Label Grid.Column="0"
                                               Style="{StaticResource IconGlyph}"
                                               Text="{StaticResource IconStar}"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsPrimary}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Style="{StaticResource BodyStrongText}"
                                                   Text="{Binding Label}" />
                                            <Label Style="{StaticResource OverlineText}"
                                                   IsVisible="{Binding IsPrimary}"
                                                   Text="{x:Static strings:AppStrings.SkillPrimaryBadge}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Style="{StaticResource CaptionText}"
                                               Text="{Binding YearsSummary}"
                                               VerticalOptions="Center" />
                                        <controls:StatusPill Grid.Column="3"
                                                             VerticalOptions="Center"
                                                             Text="{Binding StateLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding Skills.Count, Converter={StaticResource CountEmpty}}"
                               Style="{StaticResource SmallText}"
                               Text="{x:Static strings:AppStrings.HomeNoSkills}" />
                        <BoxView IsVisible="{Binding HasAbout}" Style="{StaticResource DividerLine}" Margin="0,8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Availability & pay -->
                <Label Style="{StaticResource OverlineText}"
                       Text="{x:Static strings:AppStrings.AvailabilitySectionTitle}" />
                <Border Style="{StaticResource SurfaceCardDense}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   Text="{StaticResource IconClock}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource BodyStrongText}"
                                   Text="{Binding AvailabilityText}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10"
                              IsVisible="{Binding HasSalary}">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   Text="{StaticResource IconBanknote}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource SmallText}"
                                   Text="{Binding SalaryText}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- About -->
                <VerticalStackLayout IsVisible="{Binding HasAbout}" Spacing="8">
                    <Label Style="{StaticResource OverlineText}"
                           Text="{x:Static strings:AppStrings.HomeAboutSection}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{Binding About}" />
                </VerticalStackLayout>

                <!-- Account -->
                <Label Style="{StaticResource OverlineText}"
                       Margin="0,6,0,0"
                       Text="{x:Static strings:AppStrings.HomeAccountSection}" />
                <BoxView Style="{StaticResource DividerLine}" />
                <Button Style="{StaticResource TextButton}"
                        Command="{Binding SwitchToEmployerCommand}"
                        HorizontalOptions="Start"
                        SemanticProperties.Description="{x:Static strings:AppStrings.SwitchToEmployerCta}"
                        Text="{x:Static strings:AppStrings.SwitchToEmployerCta}" />
                <Button Style="{StaticResource TextButton}"
                        Command="{Binding LogoutCommand}"
                        HorizontalOptions="Start"
                        SemanticProperties.Description="{x:Static strings:AppStrings.LogoutCta}"
                        Text="{x:Static strings:AppStrings.LogoutCta}"
                        TextColor="{DynamicResource Error}" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
