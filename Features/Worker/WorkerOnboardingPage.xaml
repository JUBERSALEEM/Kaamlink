<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KaamLink.Features.Worker"
             xmlns:strings="clr-namespace:KaamLink.Resources.Strings"
             xmlns:controls="clr-namespace:KaamLink.Controls"
             x:Class="KaamLink.Features.Worker.WorkerOnboardingPage"
             x:Name="Page"
             x:DataType="vm:WorkerOnboardingViewModel"
             Title="{x:Static strings:AppStrings.WobTitle}"
             Shell.NavBarIsVisible="False">

    <!-- 3-step Skill Passport onboarding. The step switching, validation and the
         API calls are untouched: only the chrome, grouping and the sticky footer
         are new. The footer keeps the primary action reachable above the keyboard. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Step rail -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="16,12,16,8"
                             Spacing="8">
            <Label Style="{StaticResource CaptionText}"
                   Text="{Binding StepTitle}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <BoxView Grid.Column="0"
                         HeightRequest="4"
                         CornerRadius="2"
                         Color="{StaticResource Primary}" />
                <BoxView Grid.Column="1"
                         HeightRequest="4"
                         CornerRadius="2"
                         Color="{Binding IsStep1, Converter={StaticResource StageColorConverter}, ConverterParameter=ahead}" />
                <BoxView Grid.Column="2"
                         HeightRequest="4"
                         CornerRadius="2"
                         Color="{Binding IsStep3, Converter={StaticResource StageColorConverter}, ConverterParameter=reached}" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,20" Spacing="14">

                <VerticalStackLayout IsVisible="{Binding IsLoadingCatalog}" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsLoadingCatalog}" HorizontalOptions="Center" />
                    <Label Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"
                           Text="{x:Static strings:AppStrings.CommonLoading}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="{StaticResource ErrorSoft}"
                        StrokeThickness="0"
                        Padding="14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Style="{StaticResource IconGlyph}"
                                   TextColor="{StaticResource Error}"
                                   Text="{StaticResource IconAlertCircle}"
                                   VerticalOptions="Start" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource SmallText}"
                                   Text="{Binding ErrorMessage}" />
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadCommand}"
                                SemanticProperties.Description="{x:Static strings:AppStrings.RetryCta}"
                                Text="{x:Static strings:AppStrings.RetryCta}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ STEP 1 · basics ============ -->
                <VerticalStackLayout IsVisible="{Binding IsStep1}" Style="{StaticResource SectionStack}">
                    <Label SemanticProperties.HeadingLevel="Level1"
                           Style="{StaticResource TitleText}"
                           Text="{x:Static strings:AppStrings.WobBasicsHeadline}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{x:Static strings:AppStrings.WobBasicsBody}" />

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.WobIdentitySection}" />
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <VerticalStackLayout Style="{StaticResource FormStack}">
                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.DisplayNameLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry AutomationProperties.Name="{x:Static strings:AppStrings.DisplayNameLabel}"
                                           BackgroundColor="Transparent"
                                           Text="{Binding DisplayName}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.ProfessionCategoryLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Picker ItemDisplayBinding="{Binding Label}"
                                            ItemsSource="{Binding ProfessionCategories}"
                                            BackgroundColor="Transparent"
                                            SelectedItem="{Binding SelectedProfessionCategory}"
                                            Title="{x:Static strings:AppStrings.ProfessionCategoryLabel}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.ProfessionLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Picker ItemDisplayBinding="{Binding Label}"
                                            ItemsSource="{Binding ProfessionOptions}"
                                            BackgroundColor="Transparent"
                                            SelectedItem="{Binding SelectedProfession}"
                                            Title="{x:Static strings:AppStrings.ProfessionLabel}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.WobLocationSection}" />
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <VerticalStackLayout Style="{StaticResource FormStack}">
                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.EmirateLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Picker ItemDisplayBinding="{Binding Label}"
                                            ItemsSource="{Binding Emirates}"
                                            BackgroundColor="Transparent"
                                            SelectedItem="{Binding SelectedEmirate}"
                                            Title="{x:Static strings:AppStrings.EmirateLabel}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.AreaLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry AutomationProperties.Name="{x:Static strings:AppStrings.AreaLabel}"
                                           BackgroundColor="Transparent"
                                           Text="{Binding Area}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============ STEP 2 · skills ============ -->
                <VerticalStackLayout IsVisible="{Binding IsStep2}" Style="{StaticResource SectionStack}">
                    <Label SemanticProperties.HeadingLevel="Level1"
                           Style="{StaticResource TitleText}"
                           Text="{x:Static strings:AppStrings.WobSkillsTitle}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{x:Static strings:AppStrings.WobSkillsSubtitle}" />

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.WobSkillAddSection}" />
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <VerticalStackLayout Style="{StaticResource FormStack}">
                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.ProfessionCategoryLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Picker ItemDisplayBinding="{Binding Label}"
                                            ItemsSource="{Binding SkillCategories}"
                                            BackgroundColor="Transparent"
                                            SelectedItem="{Binding SelectedSkillCategory}"
                                            Title="{x:Static strings:AppStrings.ProfessionCategoryLabel}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.SkillLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Picker ItemDisplayBinding="{Binding Label}"
                                            ItemsSource="{Binding SkillOptions}"
                                            BackgroundColor="Transparent"
                                            SelectedItem="{Binding SelectedSkill}"
                                            Title="{x:Static strings:AppStrings.SkillLabel}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Style="{StaticResource FieldStack}">
                                <Label Style="{StaticResource LabelText}"
                                       Text="{x:Static strings:AppStrings.YearsLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry AutomationProperties.Name="{x:Static strings:AppStrings.YearsLabel}"
                                           BackgroundColor="Transparent"
                                           Keyboard="Numeric"
                                           MaxLength="2"
                                           Text="{Binding YearsText}" />
                                </Border>
                            </VerticalStackLayout>

                            <Button Style="{StaticResource SubtleButton}"
                                    Command="{Binding AddSkillCommand}"
                                    SemanticProperties.Description="{x:Static strings:AppStrings.AddSkillCta}"
                                    Text="{x:Static strings:AppStrings.AddSkillCta}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.SkillsSectionTitle}" />

                    <Border IsVisible="{Binding AddedSkills.Count, Converter={StaticResource CountPositive}}"
                            Style="{StaticResource SurfaceCardDense}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AddedSkills}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AddedSkillModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Style="{StaticResource SmallStrongText}"
                                                   Text="{Binding Summary}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource TextButtonMuted}"
                                                FontFamily="Lucide"
                                                FontSize="16"
                                                HeightRequest="48"
                                                WidthRequest="48"
                                                Padding="0"
                                                Command="{Binding BindingContext.RemoveSkillCommand, Source={x:Reference Page}}"
                                                CommandParameter="{Binding .}"
                                                SemanticProperties.Description="{x:Static strings:AppStrings.RemoveSkillCta}"
                                                Text="{StaticResource IconClose}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============ STEP 3 · preferences ============ -->
                <VerticalStackLayout IsVisible="{Binding IsStep3}" Style="{StaticResource SectionStack}">
                    <Label SemanticProperties.HeadingLevel="Level1"
                           Style="{StaticResource TitleText}"
                           Text="{x:Static strings:AppStrings.WobAvailabilityTitle}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{x:Static strings:AppStrings.WobPreferencesBody}" />

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.AvailabilityLabel}" />
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <Border Style="{StaticResource FieldBox}">
                            <Picker ItemDisplayBinding="{Binding Label}"
                                    ItemsSource="{Binding Availabilities}"
                                    BackgroundColor="Transparent"
                                    SelectedItem="{Binding SelectedAvailability}"
                                    Title="{x:Static strings:AppStrings.AvailabilityLabel}" />
                        </Border>
                    </Border>

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.WobPaySection}" />
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <VerticalStackLayout Style="{StaticResource FormStack}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Style="{StaticResource FieldStack}">
                                    <Label Style="{StaticResource LabelText}"
                                           Text="{x:Static strings:AppStrings.SalaryMinLabel}" />
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry AutomationProperties.Name="{x:Static strings:AppStrings.SalaryMinLabel}"
                                               BackgroundColor="Transparent"
                                               Keyboard="Numeric"
                                               Text="{Binding SalaryMinText}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Style="{StaticResource FieldStack}">
                                    <Label Style="{StaticResource LabelText}"
                                           Text="{x:Static strings:AppStrings.SalaryMaxLabel}" />
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry AutomationProperties.Name="{x:Static strings:AppStrings.SalaryMaxLabel}"
                                               BackgroundColor="Transparent"
                                               Keyboard="Numeric"
                                               Text="{Binding SalaryMaxText}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <Label Style="{StaticResource FieldHint}"
                                   Text="{x:Static strings:AppStrings.WobPayHint}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource OverlineText}"
                           Margin="0,6,0,0"
                           Text="{x:Static strings:AppStrings.WobAboutSection}" />
                    <Border Style="{StaticResource SurfaceCardDense}">
                        <Border Style="{StaticResource FieldBox}" Padding="12,6">
                            <Editor AutomationProperties.Name="{x:Static strings:AppStrings.AboutLabel}"
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    MinimumHeightRequest="96"
                                    Placeholder="{x:Static strings:AppStrings.WobAboutPlaceholder}"
                                    Text="{Binding About}" />
                        </Border>
                    </Border>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky step navigation -->
        <Grid Grid.Row="2"
              Style="{StaticResource BottomDock}"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                    IsVisible="{Binding IsStep1, Converter={StaticResource InvertedBoolConverter}, FallbackValue=False}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BackCta}"
                    Text="{x:Static strings:AppStrings.BackCta}"
                    WidthRequest="96" />
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ContinueFromBasicsCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                    IsVisible="{Binding IsStep1}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.ContinueCta}"
                    Text="{x:Static strings:AppStrings.ContinueCta}" />
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ContinueFromSkillsCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                    IsVisible="{Binding IsStep2}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.ContinueCta}"
                    Text="{x:Static strings:AppStrings.ContinueCta}" />
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding FinishCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                    IsVisible="{Binding IsStep3}"
                    SemanticProperties.Description="{x:Static strings:AppStrings.WobFinishCta}"
                    Text="{x:Static strings:AppStrings.WobFinishCta}" />
        </Grid>
    </Grid>
</ContentPage>
