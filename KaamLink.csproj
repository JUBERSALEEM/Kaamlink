<Project Sdk="Microsoft.NET.Sdk">

	<!--
		KaamLink — UAE direct-hiring platform.
		V1 is ANDROID-FIRST (see docs/phase-01-report.md). Do not add desktop-first work here.
		To restore iOS/MacCatalyst/Windows targets in the future, re-add the TFMs below
		and restore the matching Platforms/* folders from git history.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>KaamLink</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en</NeutralLanguage>

		<!--
			Compile XAML to IL at build time: faster startup, XAML errors at build time.
			The newer "SourceGen" inflator crashed INTERNALLY on App.xaml (MAUIG1001:
			dictionary key 'Microsoft.Maui.Controls.Xaml.ElementNode' — a generator bug,
			not a XAML mistake), so V1 stays on the proven XamlC path. Retry SourceGen
			on a later .NET 10 servicing SDK.
		-->
		<MauiXamlInflator>XamlC</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>KaamLink</ApplicationTitle>

		<!--
			App identifier. Placeholder until the Play Console listing is created —
			it CANNOT be changed after the first upload, so finalize before release.
		-->
		<ApplicationId>com.kaamlink.app</ApplicationId>

		<!-- Pre-release versioning: 0.x until the first production release. -->
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!--
			Public HTTPS API base URL for Release/staging builds, e.g.
			-p:KaamLinkApiBaseUrl=https://api.example.com/
			Debug builds may also use this for a cleartext LAN host; the Debug-only
			Android manifest permits cleartext. Never put secrets in this URL.
		-->
		<KaamLinkApiBaseUrl Condition="'$(KaamLinkApiBaseUrl)' == ''"></KaamLinkApiBaseUrl>
		<!--
			Supabase email OTP project. Both values are PUBLIC: the URL and
			publishable/anon key are designed to ship in a mobile client. Override
			with -p:KaamLinkSupabaseUrl=... -p:KaamLinkSupabaseAnonKey=... when
			moving to another Supabase project. Never put a service-role key here.
		-->
		<KaamLinkSupabaseUrl Condition="'$(KaamLinkSupabaseUrl)' == ''">https://zyklrndmmcmsktagkzek.supabase.co</KaamLinkSupabaseUrl>
		<KaamLinkSupabaseAnonKey Condition="'$(KaamLinkSupabaseAnonKey)' == ''">sb_publishable_FV1pX1Xo3QCxCabFetDhIg_RszBDMab</KaamLinkSupabaseAnonKey>
		<AndroidManifest Condition="'$(Configuration)' == 'Debug'">Platforms\Android\AndroidManifest.Debug.xml</AndroidManifest>

		<!-- Minimum Android 5.0 (API 21): required to reach the affordable devices this product targets. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!--
		Sideloading a Debug build.
		Debug uses Fast Deployment: the managed assemblies are kept OUT of the .apk and
		pushed over adb by `-t:Install`. A .apk built that way installs on a phone and
		then crashes on launch ("No assemblies found"), which looks like a broken app
		rather than a deployment choice (dotnet/android#12011).

		  dotnet build KaamLink.csproj -c Debug -f net10.0-android -p:KaamLinkStandaloneApk=true
		  adb install -r bin\Debug\net10.0-android\com.kaamlink.app-Signed.apk

		gives a self-contained Debug .apk that runs on its own. Leave it off for the
		normal deploy loop, where Fast Deployment is much faster.
	-->
	<PropertyGroup Condition="'$(KaamLinkStandaloneApk)' == 'true'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

		<!--
			One .apk for every phone: ARM 32/64-bit and x86/x64. A Visual Studio deploy
			builds ONLY for the selected device, so deploying to an x86_64 emulator leaves
			an x86_64-only .apk behind and the phone correctly answers "app not compatible"
			(and `adb install` reports INSTALL_FAILED_NO_MATCHING_ABIS).
			android-arm is kept because V1 targets affordable, older handsets (min API 21).
			.NET 11 note: the CoreCLR workload ships no android-arm / android-x86 packs
			(dotnet/android#12172); drop those two RIDs when the project moves to .NET 11.
		-->
		<RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>

		<!-- A Release build defaults to an .aab, which cannot be installed on a phone. -->
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Repo-root guard: this single project lives at the repository root, so the SDK's
			default **/*.cs glob would also compile backend/**/*.cs (EF Core / xUnit / ASP.NET
			code that has no references here) — that is the VS Error List CS0246 flood on
			IEntityTypeConfiguration/IHealthCheck/InlineData. The backend builds separately
			via backend/KaamLink.Backend.slnx; exclude its tree from THIS project.
		-->
		<Compile Remove="backend\**\*.cs" />
		<None Remove="backend\**\*" />
	</ItemGroup>

	<ItemGroup>
		<!-- App icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#140E2A" />

		<!-- Splash screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#140E2A" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- HttpClientFactory (AddHttpClient): correct socket-pool lifetime for the API client. -->
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<!-- MVVM source generators ([ObservableProperty]/[RelayCommand]) — the app's MVVM standard. -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<!-- Bake the configured API URL into assembly metadata; ApiConfig reads it at runtime. -->
	<ItemGroup Condition="'$(KaamLinkApiBaseUrl)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>KaamLink.ApiBaseUrl</_Parameter1>
			<_Parameter2>$(KaamLinkApiBaseUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Bake public Supabase settings into assembly metadata; SupabaseConfig reads them. -->
	<ItemGroup Condition="'$(KaamLinkSupabaseUrl)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>KaamLink.SupabaseUrl</_Parameter1>
			<_Parameter2>$(KaamLinkSupabaseUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup Condition="'$(KaamLinkSupabaseAnonKey)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>KaamLink.SupabaseAnonKey</_Parameter1>
			<_Parameter2>$(KaamLinkSupabaseAnonKey)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!--
		Never silently ship another unaddressable Release APK. A Release build without
		a URL still compiles for UI review, but warns and the app shows a clear
		"server not configured" state instead of pretending the device is offline.
	-->
	<Target Name="WarnUnconfiguredKaamLinkApi"
	        BeforeTargets="Build"
	        Condition="'$(Configuration)' == 'Release' and '$(KaamLinkApiBaseUrl)' == ''">
		<Warning Text="KaamLinkApiBaseUrl is not set. Pass -p:KaamLinkApiBaseUrl=https://api.example.com/ for a build that can reach the backend." />
	</Target>

</Project>
