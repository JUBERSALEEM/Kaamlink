<Project Sdk="Microsoft.NET.Sdk">

	<!--
		KaamLink — UAE direct-hiring platform.
		V1 is ANDROID-FIRST (see docs/phase-01-report.md). Do not add desktop-first work here.
		To restore iOS/MacCatalyst/Windows targets in the future, re-add the TFMs below
		and restore the matching Platforms/* folders from git history.
	-->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>KaamLink</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NeutralLanguage>en</NeutralLanguage>

		<!-- Compile XAML to C# at build time: faster builds, earlier XAML errors, smaller runtime cost. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>KaamLink</ApplicationTitle>

		<!--
			App identifier. Placeholder until the Play Console listing is created —
			it CANNOT be changed after the first upload, so finalize before release.
		-->
		<ApplicationId>com.kaamlink.app</ApplicationId>

		<!-- Pre-release versioning: 0.x until the first production release. -->
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Minimum Android 5.0 (API 21): required to reach the affordable devices this product targets. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F766E" />

		<!-- Splash screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F766E" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MVVM source generators ([ObservableProperty]/[RelayCommand]) — the app's MVVM standard. -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

</Project>
