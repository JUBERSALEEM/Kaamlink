<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicit package source so `dotnet restore` works even on machines whose
    global NuGet config lost the gallery (a common cause of "NU1101/NU1102 —
    package could not be found" storms). repo-level only; machine-wide sources
    elsewhere are untouched.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
