<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only cleartext policy. QA can point a physical phone at a LAN backend
    with -p:KaamLinkApiBaseUrl=http://192.168.1.20:8080/ without editing source.
    Release builds use network_security_config.xml, which keeps cleartext OFF.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
