<?xml version="1.0" encoding="UTF-8" ?>
<!--
    KaamLink design tokens — single source of truth for color (2026 refresh).
    Screens reference these tokens (or style classes in Styles.xaml), never raw hex.
    Rationale: rich indigo/violet brand + warm amber accent on warm "stone" neutrals —
    moves the product away from the flat teal/blue-gray "ERP" look. Key NAMES are
    frozen (pages bind to them); only VALUES evolve. Dark-mode palette is introduced
    together with dark-mode support in a later phase (AppThemeBinding), not piecemeal.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand: indigo → violet with a warm amber accent -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDark">#4338CA</Color>
    <Color x:Key="PrimarySoft">#EEF2FF</Color>
    <Color x:Key="Secondary">#7C3AED</Color>
    <Color x:Key="Tertiary">#8B5CF6</Color>
    <Color x:Key="Accent">#F97316</Color>
    <Color x:Key="AccentDark">#EA580C</Color>

    <!-- Semantic: vivid, high-contrast (status pills must read on small screens) -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="Info">#2563EB</Color>

    <!-- Warm "stone" neutrals: replaces the cold blue-gray ERP ramp -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray50">#FAFAF9</Color>
    <Color x:Key="Gray100">#F5F5F4</Color>
    <Color x:Key="Gray200">#E7E5E4</Color>
    <Color x:Key="Gray300">#D6D3D1</Color>
    <Color x:Key="Gray400">#A8A29E</Color>
    <Color x:Key="Gray500">#78716C</Color>
    <Color x:Key="Gray600">#57534E</Color>
    <Color x:Key="Gray700">#44403C</Color>
    <Color x:Key="Gray800">#292524</Color>
    <Color x:Key="Gray900">#1C1917</Color>

    <!-- Surfaces: faintly tinted page canvas so white cards pop with the shadow -->
    <Color x:Key="PageBackground">#F6F7FB</Color>
    <Color x:Key="CardSurface">#FFFFFF</Color>
    <Color x:Key="Border">#E7E5E4</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#1C1917</Color>
    <Color x:Key="TextSecondary">#57534E</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <!-- Brushes (only for what is actually used; add when needed) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
