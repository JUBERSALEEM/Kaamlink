<?xml version="1.0" encoding="UTF-8" ?>
<!--
    KaamLink theme palette — "Clay" (default, light).
    Rich electric-blue / mint accents over cool blue-white clay surfaces.
    Spec: docs/ui-redesign/04-claymorphism-theme.md

    This file is a THEME DICTIONARY, not the whole design system:
      * palette + clay tokens live here (swapped by ThemeService when the user
        picks another theme);
      * icon glyphs live in Icons.xaml because they never change with a theme;
      * typography, spacing and control recipes live in Styles.xaml.

    Rules:
      * Every key here must also exist in every other theme dictionary
        (Resources/Themes/*.xaml) — tools/verify-ui-redesign.py fails otherwise,
        because a missing token shows up as a half-themed screen.
      * Pages/setters reference these keys through {DynamicResource ...} so a
        theme switch repaints the live app. Never hard-code a hex in a page.
      * Soft-clay surfaces use calm tonal fills, explicit component edges, and a
        restrained cast shadow. Brand action fills retain their gradient. Palette
        contrast is measured by tools/verify-theme-contrast.py.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KaamLink.Resources.Styles.ClayPalette">

    <!-- Runtime theme switch marker: ThemeService identifies every palette by this key. -->
    <x:String x:Key="KaamLinkThemeId">clay</x:String>

    <!-- ================= Brand ================= -->
    <Color x:Key="Primary">#075FC2</Color>
    <Color x:Key="PrimaryTop">#5B91FF</Color>
    <Color x:Key="PrimaryBottom">#0A4FA8</Color>
    <Color x:Key="PrimaryDark">#084A8C</Color>
    <Color x:Key="PrimarySoft">#DCE7F6</Color>
    <Color x:Key="PrimarySoftDeep">#C9DAF0</Color>
    <!-- Fill tokens are separate from `Primary`: on a dusk theme the accent used
         for text must be LIGHT (to sit on dark clay), while a filled button must
         stay saturated enough for white text. One key cannot be both. -->
    <Color x:Key="PrimaryFill">#075FC2</Color>
    <Color x:Key="PrimaryFillTop">#1F67C8</Color>
    <Color x:Key="PrimaryFillBottom">#084A8C</Color>

    <!-- Legacy aliases: kept so converter/style lookups keep resolving. -->
    <Color x:Key="Secondary">#075FC2</Color>
    <Color x:Key="Tertiary">#0B6E68</Color>

    <Color x:Key="Accent">#0B6E68</Color>
    <Color x:Key="AccentTop">#4ED9BE</Color>
    <Color x:Key="AccentBottom">#095651</Color>
    <Color x:Key="AccentDark">#095651</Color>
    <Color x:Key="AccentSoft">#D8EDEA</Color>
    <Color x:Key="AccentFill">#0B6E68</Color>
    <Color x:Key="AccentFillTop">#1B8078</Color>
    <Color x:Key="AccentFillBottom">#095651</Color>

    <!-- ================= Semantic status ================= -->
    <Color x:Key="Success">#14663C</Color>
    <Color x:Key="SuccessSoft">#DBF0E3</Color>
    <Color x:Key="Warning">#8A5300</Color>
    <Color x:Key="WarningSoft">#FBEBD2</Color>
    <Color x:Key="Error">#B3261E</Color>
    <Color x:Key="ErrorSoft">#FADFDC</Color>
    <Color x:Key="Info">#075FC2</Color>
    <Color x:Key="InfoSoft">#DCE7F6</Color>

    <!-- ================= Neutrals ================= -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray50">#FAFBFF</Color>
    <Color x:Key="Gray100">#F4F6FD</Color>
    <Color x:Key="Gray200">#ECEEFA</Color>
    <Color x:Key="Gray300">#DDE1F1</Color>
    <Color x:Key="Gray400">#A9B2CC</Color>
    <Color x:Key="Gray500">#7883A3</Color>
    <Color x:Key="Gray600">#525C7A</Color>
    <Color x:Key="Gray700">#34475C</Color>
    <Color x:Key="Gray800">#232B45</Color>
    <Color x:Key="Gray900">#172638</Color>

    <!-- ================= Surfaces ================= -->
    <Color x:Key="PageBackground">#E8EFF9</Color>
    <Color x:Key="PageBackgroundTop">#F4F8FE</Color>
    <Color x:Key="PageBackgroundBottom">#DCE7F5</Color>
    <Color x:Key="CardSurface">#EAF0F9</Color>
    <Color x:Key="CardSurfaceTop">#FBFDFF</Color>
    <Color x:Key="CardSurfaceBottom">#D9E5F3</Color>
    <Color x:Key="CardSurfaceAlt">#DCE6F2</Color>
    <Color x:Key="CardSurfaceAltTop">#EFF5FD</Color>
    <Color x:Key="CardSurfaceAltBottom">#CFDDEE</Color>
    <Color x:Key="Border">#C2CCD9</Color>
    <!-- Input outlines need 3:1 non-text contrast (WCAG 1.4.11). -->
    <Color x:Key="BorderStrong">#6E8198</Color>
    <Color x:Key="Divider">#CDD6E1</Color>
    <Color x:Key="Scrim">#66171F36</Color>

    <!-- ================= Clay material ================= -->
    <!-- Light edge along the top of every clay surface. -->
    <Color x:Key="ClayHighlight">#F6F8FB</Color>
    <!-- Slightly darker edge along the bottom, so the surface reads as pressed clay. -->
    <Color x:Key="ClayEdgeLow">#BEC9D7</Color>
    <!-- Cast shadow: desaturated blue, applied at low opacity over the page. -->
    <Color x:Key="ClayShadow">#9AA9BA</Color>
    <Color x:Key="ClayShadowDeep">#617287</Color>
    <Color x:Key="ClayInset">#D7DFE9</Color>

    <!-- ================= Text ================= -->
    <Color x:Key="TextPrimary">#172638</Color>
    <Color x:Key="TextSecondary">#34475C</Color>
    <Color x:Key="TextMuted">#50637A</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextDisabled">#98A1BC</Color>

    <!-- ================= Brushes ================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoft}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="ClayShadowBrush" Color="{StaticResource ClayShadow}" />
    <SolidColorBrush x:Key="ClayHighlightBrush" Color="{StaticResource ClayHighlight}" />
    <SolidColorBrush x:Key="ClayEdgeLowBrush" Color="{StaticResource ClayEdgeLow}" />

    <!-- Clay gradients: light from above, so the top of every surface is lighter. -->
    <!--
        Clay surfaces are vertical gradients: light from above, a calm body and a
        slightly cooler base. The top/bottom colours are also contrast-checked, so
        text stays readable at both ends of every card.
    -->
    <LinearGradientBrush x:Key="ClayPageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PageBackgroundTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PageBackground}" Offset="0.55" />
        <GradientStop Color="{StaticResource PageBackgroundBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource CardSurfaceTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource CardSurface}" Offset="0.55" />
        <GradientStop Color="{StaticResource CardSurfaceBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayCardSoftBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource CardSurfaceAltTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource CardSurfaceAlt}" Offset="0.55" />
        <GradientStop Color="{StaticResource CardSurfaceAltBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Primary clay: saturated, still with a lighter top so it looks moulded. -->
    <LinearGradientBrush x:Key="ClayPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryFillTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimaryFill}" Offset="0.55" />
        <GradientStop Color="{StaticResource PrimaryFillBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentFillTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource AccentFill}" Offset="0.55" />
        <GradientStop Color="{StaticResource AccentFillBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Soft tinted wells for icon tiles and quiet buttons. -->
    <SolidColorBrush x:Key="ClayPrimarySoftBrush" Color="{StaticResource PrimarySoft}" />

    <SolidColorBrush x:Key="ClayAccentSoftBrush" Color="{StaticResource AccentSoft}" />

    <!-- Inset well (fields, progress tracks): shadow at the top, light at the base. -->
    <SolidColorBrush x:Key="ClayInsetBrush" Color="{StaticResource ClayInset}" />

    <LinearGradientBrush x:Key="ClaySoftBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimarySoft}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimarySoftDeep}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClayBarBrush" Color="{StaticResource PageBackground}" />

</ResourceDictionary>
