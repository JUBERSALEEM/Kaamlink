<?xml version="1.0" encoding="UTF-8" ?>
<!--
    KaamLink icon glyphs — Lucide (ISC, see Resources/Fonts/lucide-LICENSE.txt).

    Theme-independent on purpose: a theme swaps colours, never iconography, so
    these live outside the palette dictionaries (Resources/Styles/Colors.xaml and
    Resources/Themes/*.xaml).

    Every value is a single codepoint, verified against lucide.ttf by
    tools/verify-ui-redesign.py. That check also fails when this file yields no
    glyphs at all, so an empty or moved file can never pass vacuously.

    Usage:
        <Label Style="{StaticResource IconGlyph}" Text="{StaticResource IconPin}" />
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:String x:Key="IconHardHat">&#xE0EE;</x:String>
