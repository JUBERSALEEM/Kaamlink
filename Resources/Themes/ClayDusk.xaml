<?xml version="1.0" encoding="UTF-8" ?>
<!--
    KaamLink theme palette — "Clay Dusk" (alternate, dark clay).
    Spec: docs/ui-redesign/04-claymorphism-theme.md

    Same key set as Resources/Styles/Colors.xaml — enforced by
    tools/verify-ui-redesign.py (theme parity) and contrast-checked by
    tools/verify-theme-contrast.py. A theme is a palette swap, never a second
    layout: the styles and pages are shared.

    Dusk uses equivalent dark tonal surfaces, a visible outline, and restrained
    dark casts. It shares the same page and control layouts as the light palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================= Brand ================= -->
    <!-- `Primary` is the accent for TEXT and icons on dark clay, so it is light. -->
    <Color x:Key="Primary">#9CC2F0</Color>
    <Color x:Key="PrimaryTop">#B7D4F7</Color>
    <Color x:Key="PrimaryBottom">#7FA9DC</Color>
    <Color x:Key="PrimaryDark">#7FA9DC</Color>
    <Color x:Key="PrimarySoft">#283440</Color>
    <Color x:Key="PrimarySoftDeep">#32404E</Color>
    <!-- Filled buttons keep a saturated clay body so white text stays legible. -->
    <Color x:Key="PrimaryFill">#2E62A8</Color>
    <Color x:Key="PrimaryFillTop">#3A72BC</Color>
    <Color x:Key="PrimaryFillBottom">#234C86</Color>

    <Color x:Key="Secondary">#9CC2F0</Color>
    <Color x:Key="Tertiary">#7FD8CB</Color>

    <Color x:Key="Accent">#7FD8CB</Color>
    <Color x:Key="AccentTop">#9AE6DA</Color>
    <Color x:Key="AccentBottom">#5FB8AC</Color>
    <Color x:Key="AccentDark">#5FB8AC</Color>
    <Color x:Key="AccentSoft">#263E3D</Color>
    <Color x:Key="AccentFill">#106B63</Color>
    <Color x:Key="AccentFillTop">#17847A</Color>
    <Color x:Key="AccentFillBottom">#0B544E</Color>

    <!-- ================= Semantic status ================= -->
    <Color x:Key="Success">#7EDCA4</Color>
    <Color x:Key="SuccessSoft">#23372D</Color>
    <Color x:Key="Warning">#F2C67C</Color>
    <Color x:Key="WarningSoft">#3B3323</Color>
    <Color x:Key="Error">#FFA098</Color>
    <Color x:Key="ErrorSoft">#43282A</Color>
    <Color x:Key="Info">#9CC2F0</Color>
    <Color x:Key="InfoSoft">#293746</Color>

    <!-- ================= Neutrals ================= -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#10151B</Color>
    <Color x:Key="Gray50">#29323D</Color>
    <Color x:Key="Gray100">#252E39</Color>
    <Color x:Key="Gray200">#222A34</Color>
    <Color x:Key="Gray300">#3A4654</Color>
    <Color x:Key="Gray400">#718094</Color>
    <Color x:Key="Gray500">#8797A9</Color>
    <Color x:Key="Gray600">#A0ADBC</Color>
    <Color x:Key="Gray700">#BEC9D5</Color>
    <Color x:Key="Gray800">#D8E0E8</Color>
    <Color x:Key="Gray900">#F1F4F7</Color>

    <!-- ================= Surfaces ================= -->
    <Color x:Key="PageBackground">#202731</Color>
    <Color x:Key="PageBackgroundTop">#252E39</Color>
    <Color x:Key="PageBackgroundBottom">#1A2029</Color>
    <Color x:Key="CardSurface">#242C36</Color>
    <Color x:Key="CardSurfaceTop">#2E3945</Color>
    <Color x:Key="CardSurfaceBottom">#1E252E</Color>
    <Color x:Key="CardSurfaceAlt">#29333E</Color>
    <Color x:Key="CardSurfaceAltTop">#34414E</Color>
    <Color x:Key="CardSurfaceAltBottom">#222A34</Color>
    <Color x:Key="Border">#445261</Color>
    <Color x:Key="BorderStrong">#9AAABD</Color>
    <Color x:Key="Divider">#36424F</Color>
    <Color x:Key="Scrim">#99000000</Color>

    <!-- ================= Clay material ================= -->
    <Color x:Key="ClayHighlight">#3D4A58</Color>
    <Color x:Key="ClayEdgeLow">#171D25</Color>
    <Color x:Key="ClayShadow">#10151B</Color>
    <Color x:Key="ClayShadowDeep">#10151B</Color>
    <Color x:Key="ClayInset">#1C232C</Color>

    <!-- ================= Text ================= -->
    <Color x:Key="TextPrimary">#F1F4F7</Color>
    <Color x:Key="TextSecondary">#D6DEE7</Color>
    <Color x:Key="TextMuted">#B8C4D0</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextDisabled">#718094</Color>

    <!-- ================= Brushes ================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="ClayShadowBrush" Color="{StaticResource ClayShadow}" />
    <SolidColorBrush x:Key="ClayHighlightBrush" Color="{StaticResource ClayHighlight}" />
    <SolidColorBrush x:Key="ClayEdgeLowBrush" Color="{StaticResource ClayEdgeLow}" />

    <SolidColorBrush x:Key="ClayPageBrush" Color="{StaticResource PageBackground}" />

    <SolidColorBrush x:Key="ClayCardBrush" Color="{StaticResource CardSurface}" />

    <SolidColorBrush x:Key="ClayCardSoftBrush" Color="{StaticResource CardSurfaceAlt}" />

    <LinearGradientBrush x:Key="ClayPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryFillTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimaryFill}" Offset="0.55" />
        <GradientStop Color="{StaticResource PrimaryFillBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentFillTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource AccentFill}" Offset="0.55" />
        <GradientStop Color="{StaticResource AccentFillBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClayPrimarySoftBrush" Color="{StaticResource PrimarySoft}" />

    <SolidColorBrush x:Key="ClayAccentSoftBrush" Color="{StaticResource AccentSoft}" />

    <SolidColorBrush x:Key="ClayInsetBrush" Color="{StaticResource ClayInset}" />

    <LinearGradientBrush x:Key="ClaySoftBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimarySoft}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimarySoftDeep}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClayBarBrush" Color="{StaticResource PageBackground}" />

</ResourceDictionary>
