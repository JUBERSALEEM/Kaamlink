<?xml version="1.0" encoding="UTF-8" ?>
<!--
    KaamLink theme palette — "Clay Dusk" (alternate, rich midnight navy).
    Deep blue-indigo surfaces, electric-blue primary, mint accent and warm status
    colors. It is intentionally NOT black/AMOLED; modern apps use chromatic darks.
    Spec: docs/ui-redesign/04-claymorphism-theme.md

    Same key set as Resources/Styles/Colors.xaml — enforced by
    tools/verify-ui-redesign.py (theme parity) and contrast-checked by
    tools/verify-theme-contrast.py. A theme is a palette swap, never a second
    layout: the styles and pages are shared.

    Dusk uses equivalent dark tonal surfaces, a visible outline, and restrained
    dark casts. It shares the same page and control layouts as the light palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KaamLink.Resources.Themes.ClayDuskPalette">

    <!-- Runtime theme switch marker: must match Resources/Styles/Colors.xaml order. -->
    <x:String x:Key="KaamLinkThemeId">clay-dusk</x:String>

    <!-- ================= Brand ================= -->
    <!-- `Primary` is the accent for TEXT and icons on dark clay, so it is light. -->
    <Color x:Key="Primary">#8DBBFF</Color>
    <Color x:Key="PrimaryTop">#B7D5FF</Color>
    <Color x:Key="PrimaryBottom">#5B91FF</Color>
    <Color x:Key="PrimaryDark">#6FA5F5</Color>
    <Color x:Key="PrimarySoft">#1C3A63</Color>
    <Color x:Key="PrimarySoftDeep">#244A79</Color>
    <!-- Filled buttons keep a saturated clay body so white text stays legible. -->
    <Color x:Key="PrimaryFill">#245BC8</Color>
    <Color x:Key="PrimaryFillTop">#2F6FE0</Color>
    <Color x:Key="PrimaryFillBottom">#1748A8</Color>

    <Color x:Key="Secondary">#8DBBFF</Color>
    <Color x:Key="Tertiary">#62E6CF</Color>

    <Color x:Key="Accent">#62E6CF</Color>
    <Color x:Key="AccentTop">#9CF5E5</Color>
    <Color x:Key="AccentBottom">#3BD0B7</Color>
    <Color x:Key="AccentDark">#3BD0B7</Color>
    <Color x:Key="AccentSoft">#124039</Color>
    <Color x:Key="AccentFill">#126C62</Color>
    <Color x:Key="AccentFillTop">#1E7A6E</Color>
    <Color x:Key="AccentFillBottom">#0A514B</Color>

    <!-- ================= Semantic status ================= -->
    <Color x:Key="Success">#6FE3AC</Color>
    <Color x:Key="SuccessSoft">#123B2D</Color>
    <Color x:Key="Warning">#FFD07A</Color>
    <Color x:Key="WarningSoft">#443016</Color>
    <Color x:Key="Error">#FF9AA6</Color>
    <Color x:Key="ErrorSoft">#4A2029</Color>
    <Color x:Key="Info">#8FC2FF</Color>
    <Color x:Key="InfoSoft">#1B3452</Color>

    <!-- ================= Neutrals ================= -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#050A12</Color>
    <Color x:Key="Gray50">#1A2942</Color>
    <Color x:Key="Gray100">#16243A</Color>
    <Color x:Key="Gray200">#132038</Color>
    <Color x:Key="Gray300">#2C4262</Color>
    <Color x:Key="Gray400">#5C76A0</Color>
    <Color x:Key="Gray500">#7C95B8</Color>
    <Color x:Key="Gray600">#9AB1D0</Color>
    <Color x:Key="Gray700">#BCCDEC</Color>
    <Color x:Key="Gray800">#DCE6F8</Color>
    <Color x:Key="Gray900">#F4F8FF</Color>

    <!-- ================= Surfaces ================= -->
    <Color x:Key="PageBackground">#101B2E</Color>
    <Color x:Key="PageBackgroundTop">#172942</Color>
    <Color x:Key="PageBackgroundBottom">#0A1322</Color>
    <Color x:Key="CardSurface">#16263F</Color>
    <Color x:Key="CardSurfaceTop">#223A5C</Color>
    <Color x:Key="CardSurfaceBottom">#101D31</Color>
    <Color x:Key="CardSurfaceAlt">#1B3352</Color>
    <Color x:Key="CardSurfaceAltTop">#294A70</Color>
    <Color x:Key="CardSurfaceAltBottom">#13263E</Color>
    <Color x:Key="Border">#34527C</Color>
    <Color x:Key="BorderStrong">#6C8FBF</Color>
    <Color x:Key="Divider">#2A4364</Color>
    <Color x:Key="Scrim">#990A1322</Color>

    <!-- ================= Clay material ================= -->
    <Color x:Key="ClayHighlight">#3B5B86</Color>
    <Color x:Key="ClayEdgeLow">#091222</Color>
    <Color x:Key="ClayShadow">#020812</Color>
    <Color x:Key="ClayShadowDeep">#01050C</Color>
    <Color x:Key="ClayInset">#0E1A2C</Color>

    <!-- ================= Text ================= -->
    <Color x:Key="TextPrimary">#F4F8FF</Color>
    <Color x:Key="TextSecondary">#C2D3EC</Color>
    <Color x:Key="TextMuted">#90A8C8</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextDisabled">#6D84A5</Color>

    <!-- ================= Brushes ================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoft}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="ClayShadowBrush" Color="{StaticResource ClayShadow}" />
    <SolidColorBrush x:Key="ClayHighlightBrush" Color="{StaticResource ClayHighlight}" />
    <SolidColorBrush x:Key="ClayEdgeLowBrush" Color="{StaticResource ClayEdgeLow}" />

    <!-- Same gradient construction as the light palette; only the tokens change. -->
    <LinearGradientBrush x:Key="ClayPageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PageBackgroundTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PageBackground}" Offset="0.55" />
        <GradientStop Color="{StaticResource PageBackgroundBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource CardSurfaceTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource CardSurface}" Offset="0.55" />
        <GradientStop Color="{StaticResource CardSurfaceBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayCardSoftBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource CardSurfaceAltTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource CardSurfaceAlt}" Offset="0.55" />
        <GradientStop Color="{StaticResource CardSurfaceAltBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimaryFillTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimaryFill}" Offset="0.55" />
        <GradientStop Color="{StaticResource PrimaryFillBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ClayAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentFillTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource AccentFill}" Offset="0.55" />
        <GradientStop Color="{StaticResource AccentFillBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClayPrimarySoftBrush" Color="{StaticResource PrimarySoft}" />

    <SolidColorBrush x:Key="ClayAccentSoftBrush" Color="{StaticResource AccentSoft}" />

    <SolidColorBrush x:Key="ClayInsetBrush" Color="{StaticResource ClayInset}" />

    <LinearGradientBrush x:Key="ClaySoftBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PrimarySoft}" Offset="0.0" />
        <GradientStop Color="{StaticResource PrimarySoftDeep}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ClayBarBrush" Color="{StaticResource PageBackground}" />

</ResourceDictionary>
