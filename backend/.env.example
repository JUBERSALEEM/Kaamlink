# Copy to .env (gitignored) before `docker compose up`.
# These are DEVELOPMENT-ONLY placeholders — Production requires real secrets
# from the environment/secret manager (never committed anywhere).

# Min 32 chars. HMAC key for signing access tokens.
JWT_SIGNING_KEY=dev-only-signing-key-0123456789abcdef

# Min 16 chars. Server-side pepper for hashing OTP codes at rest.
OTP_HASHING_KEY=dev-only-hashing-key-0123
