@host = http://localhost:8080
@phone = +971501234567
@supabaseAccessToken = paste-access-token-from-magic-link-fragment

### Liveness / readiness
GET {{host}}/health/live

###
GET {{host}}/health/ready

### 1) Request OTP (dev: code appears in API logs — Otp:Provider=log)
POST {{host}}/api/v1/auth/otp/request
Content-Type: application/json

{ "phone": "{{phone}}" }

### 2) Verify OTP (paste the code from the API logs) → token pair
# @name verify
POST {{host}}/api/v1/auth/otp/verify
Content-Type: application/json

{ "phone": "{{phone}}", "code": "000000" }

### 2b) Exchange a verified Supabase magic-link access token → KaamLink token pair
# The API calls GoTrue /auth/v1/user with this token; it is not accepted directly.
# @name emailExchange
POST {{host}}/api/v1/auth/email/exchange
Content-Type: application/json

{ "accessToken": "{{supabaseAccessToken}}" }

### 3) Authorized probe
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{verify.response.body.accessToken}}

### 4) Rotate tokens
POST {{host}}/api/v1/auth/token/refresh
Content-Type: application/json

{ "refreshToken": "{{verify.response.body.refreshToken}}" }

### 5) Logout (revokes the given refresh token)
POST {{host}}/api/v1/auth/logout
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "refreshToken": "{{verify.response.body.refreshToken}}" }

// ---------------------------------------------------------------- Phase 03

### Seeded occupation catalog (bilingual)
GET {{host}}/api/v1/skills/catalog
Authorization: Bearer {{verify.response.body.accessToken}}

### Worker onboarding — step 1: basics (primarySkillId from the catalog)
PUT {{host}}/api/v1/workers/me
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "displayName": "Ahmed Ali", "primarySkillId": "bad55086-6583-4178-9d7c-47f476917eec", "emirate": "Sharjah" }

### Worker onboarding — step 2: self-declared skills (full replacement)
PUT {{host}}/api/v1/workers/me/skills
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "skills": [ { "skillId": "bad55086-6583-4178-9d7c-47f476917eec", "yearsExperience": 6 } ] }

### Worker onboarding — step 3: availability + salary + about
PUT {{host}}/api/v1/workers/me
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "availability": "Immediately", "expectedSalaryMinAed": 2500, "expectedSalaryMaxAed": 3500, "about": "Fabrication specialist" }

### Worker profile (completeness + onboarding state, computed server-side)
GET {{host}}/api/v1/workers/me
Authorization: Bearer {{verify.response.body.accessToken}}

### Employer onboarding — register a company (starts Pending review)
# @name company
POST {{host}}/api/v1/companies
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "name": "Gulf Fabrication LLC", "category": "Workshop", "emirate": "Sharjah", "area": "Industrial Area 12", "tradeLicenseNumber": "CN-1234567" }

### Employer's own companies (membership-scoped)
GET {{host}}/api/v1/companies/mine
Authorization: Bearer {{verify.response.body.accessToken}}

### ADMIN: pending review queue — requires a platform_admin token
### (Development bootstrap: register with +971500000000, see appsettings.Development.json)
GET {{host}}/api/v1/admin/companies/pending
Authorization: Bearer {{verify.response.body.accessToken}}

### ADMIN: approve a company → Verified (use {"approve":false,"reason":"…"} to reject)
POST {{host}}/api/v1/admin/companies/{{company.response.body.id}}/review
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "approve": true }

// ---------------------------------------------------------------- Phase 04

### Employer: create a vacancy (starts Draft)
# @name vacancy
POST {{host}}/api/v1/companies/{{company.response.body.id}}/vacancies
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "title": "Aluminium Fabricator", "emirate": "Sharjah", "area": "Industrial Area 12", "salaryMinAed": 3000, "salaryMaxAed": 4000, "headcount": 2, "skillIds": ["ce4dccee-4687-4af8-8937-f84b21a3c449"] }

### Publish attempt: fails while company is Pending → jobs.company_not_verified
POST {{host}}/api/v1/companies/{{company.response.body.id}}/vacancies/{{vacancy.response.body.id}}/status
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "status": "Active" }

### ADMIN: verify the company first (see the admin endpoints above), then retry publish.

### Employer's vacancies (any status, with applicant counts)
GET {{host}}/api/v1/companies/{{company.response.body.id}}/vacancies
Authorization: Bearer {{verify.response.body.accessToken}}

### Edit a vacancy (same contract as create)
PUT {{host}}/api/v1/companies/{{company.response.body.id}}/vacancies/{{vacancy.response.body.id}}
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "title": "Aluminium Fabricator — Night Shift", "emirate": "Sharjah", "salaryMinAed": 3200, "salaryMaxAed": 4200, "headcount": 3, "skillIds": ["ce4dccee-4687-4af8-8937-f84b21a3c449"] }

### WORKER feed (active only; emirate/skillId/q filters, page/pageSize ≤ 50)
GET {{host}}/api/v1/vacancies?emirate=Sharjah&page=1&pageSize=20
Authorization: Bearer {{verify.response.body.accessToken}}

### Vacancy detail (worker view; carries ownApplicationStatus when applied)
GET {{host}}/api/v1/vacancies/{{vacancy.response.body.id}}
Authorization: Bearer {{verify.response.body.accessToken}}

### WORKER: apply (requires completed onboarding; one per vacancy)
# @name application
POST {{host}}/api/v1/vacancies/{{vacancy.response.body.id}}/applications
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "coverNote": "6 years of experience, available immediately." }

### WORKER: my applications
GET {{host}}/api/v1/workers/me/applications
Authorization: Bearer {{verify.response.body.accessToken}}

### WORKER: withdraw while the decision is open
POST {{host}}/api/v1/workers/me/applications/{{application.response.body.id}}/withdraw
Authorization: Bearer {{verify.response.body.accessToken}}

### EMPLOYER: applicants of the vacancy (hiring roles only — contains phone numbers)
GET {{host}}/api/v1/companies/{{company.response.body.id}}/vacancies/{{vacancy.response.body.id}}/applications
Authorization: Bearer {{verify.response.body.accessToken}}

### EMPLOYER: decision — Viewed | Shortlisted | Rejected | Hired (terminal states are final)
POST {{host}}/api/v1/companies/{{company.response.body.id}}/vacancies/{{vacancy.response.body.id}}/applications/{{application.response.body.id}}/status
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{ "status": "Shortlisted" }

# ======================================================================
# Phase 05 — Skill assessments (server-side scoring; trust spine)
# Run AFTER the Phase 03 worker onboarding steps so {{verify}} is an
# onboarded worker with skills on the profile (e.g. Welder).
# ======================================================================

### WORKER: my assessments (skills with availability/state/latest score)
# @name myAssessments
GET {{host}}/api/v1/workers/me/assessments
Authorization: Bearer {{verify.response.body.accessToken}}

### WORKER: start an attempt for a skill that HAS a template (e.g. "Welder").
# honing in on the security rule: the response carries NO correct answers.
@attemptSkillId = COPY the "skillId" of an AssessmentAvailable row from myAssessments
# @name startAssessment
POST {{host}}/api/v1/workers/me/assessments/{{attemptSkillId}}/attempts
Authorization: Bearer {{verify.response.body.accessToken}}

### WORKER: submit answers — pass mark is 60%; a pass marks the skill AssessmentVerified.
# Answer honestly; the right options are defined only server-side.
# @name submitAssessment
POST {{host}}/api/v1/workers/me/assessments/{{attemptSkillId}}/attempts/{{startAssessment.response.body.attemptId}}/submit
Authorization: Bearer {{verify.response.body.accessToken}}
Content-Type: application/json

{
  "answers": [
    { "questionId": "{{startAssessment.response.body.questions[0].id}}", "selectedOptionIndex": 1 },
    { "questionId": "{{startAssessment.response.body.questions[1].id}}", "selectedOptionIndex": 0 },
    { "questionId": "{{startAssessment.response.body.questions[2].id}}", "selectedOptionIndex": 2 },
    { "questionId": "{{startAssessment.response.body.questions[3].id}}", "selectedOptionIndex": 1 },
    { "questionId": "{{startAssessment.response.body.questions[4].id}}", "selectedOptionIndex": 3 }
  ]
}

### Re-submit the SAME attempt → 400 assessment.already_completed (single-shot).

### Start for a skill WITHOUT a template (e.g. "Mason") → 404 assessment.not_available.
